{"badger":"share/v1","app_version":"1.1.11","created_at":"2026-09-13T05:09:28.346375Z","type":"routine","payload":{"routine":{"name":"nSuns 531LP","notes":"4 days/week. Each day has a T1 lift (9 sets) and a T2 lift (8 sets), both taken as percentages of that lift's training max. The 1+ set on the T1 lift decides how much the training max moves that week. Set a training max for each lift before your first session.","weight_source":"last_performance","history_scope":"any_workout"},"days":[{"name":"Bench / Press","scheduled_days":[1],"exercises":[{"exercise_name":"Flat Barbell Bench Press","exercise_type":"weight_reps","progression_group_key":"nsuns-t1-1","progression":{"scheme":"nsuns_t1","cadence":"week","reference_kind":"training_max","clauses":[{"trigger":"driver_reps_between","reps_min":0,"reps_max":1,"action":"none","target":"reference"},{"trigger":"driver_reps_between","reps_min":2,"reps_max":3,"action":"add_absolute","target":"reference","amount":2.5,"amount_unit":"kg"},{"trigger":"driver_reps_between","reps_min":4,"reps_max":5,"action":"add_absolute","target":"reference","amount":5.0,"amount_unit":"kg"},{"trigger":"driver_reps_at_least","reps_min":6,"action":"add_absolute","target":"reference","amount":7.5,"amount_unit":"kg"},{"trigger":"always","action":"none","target":"reference"}]},"predefined_sets":[{"is_warmup":false,"reps":5,"percent_of_reference":75.0},{"is_warmup":false,"reps":3,"percent_of_reference":85.0},{"is_warmup":false,"reps":1,"is_amrap":true,"percent_of_reference":95.0,"is_progression_driver":true},{"is_warmup":false,"reps":3,"percent_of_reference":90.0},{"is_warmup":false,"reps":3,"percent_of_reference":85.0},{"is_warmup":false,"reps":3,"percent_of_reference":80.0},{"is_warmup":false,"reps":5,"percent_of_reference":75.0},{"is_warmup":false,"reps":5,"percent_of_reference":70.0},{"is_warmup":false,"reps":5,"is_amrap":true,"percent_of_reference":65.0}]},{"exercise_name":"Overhead Barbell Press","exercise_type":"weight_reps","progression_group_ke