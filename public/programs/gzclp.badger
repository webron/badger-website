{"badger":"share/v1","app_version":"1.1.15","created_at":"2026-10-23T01:43:04.535432Z","type":"routine","payload":{"routine":{"name":"GZCLP","notes":"Cody Lefever's GZCLP. 4 days a week, three tiers a day. T1 is the heavy lift: 5x3 with the last set as many reps as you can. Miss and it moves to 6x2, then 10x1. T2 is the medium lift: 3x10, then 3x8, then 3x6. T3 is the light lift: 3x15 with the last set as many reps as you can, and the weight goes up once that set reaches 25.","weight_source":"last_performance","history_scope":"any_workout"},"days":[{"name":"Day 1","scheduled_days":[1],"cycle_length":3,"exercises":[{"exercise_name":"Barbell Back Squat","exercise_type":"weight_reps","progression_group_key":"gzclp-t1-200","progression":{"scheme":"gzclp_t1","cadence":"session","reference_kind":"working_weight","clauses":[{"trigger":"stage_is_last","action":"reset_stage","target":"stage"},{"trigger":"stage_is_last","action":"add_percent","target":"working_weight","percent":-10.0},{"trigger":"any_set_missed","action":"next_stage","target":"stage"},{"trigger":"all_sets_met","action":"add_absolute","target":"working_weight","amount":5.0,"amount_unit":"kg"},{"trigger":"always","action":"hold","target":"working_weight"}]},"predefined_sets":[{"is_warmup":false,"reps":3,"week_index":0},{"is_warmup":false,"reps":3,"week_index":0},{"is_warmup":false,"reps":3,"week_index":0},{"is_warmup":false,"reps":3,"week_index":0},{"is_warmup":false,"reps":3,"is_amrap":true,"week_index":0},{"is_warmup":false,"reps":2,"week_index":1},{"is_warmup":false,"reps":2,"week_index":1},{"is_warmup":false,"reps":2,"week_index":1},{"is_warmup":false,"reps":2,"week_index":1},{"is_warmup":false,"reps":2,"week_index":1},{"is_warmup":false,"reps":2,"is_amrap":true,"week_index":1},{"is_warmup":false,"reps":1,"week_index":2},{"is_warmup":false,"reps":1,"week_index":2},{"is_warmup":false,"reps":1,"week_index":2},{"is_warmup":false,"reps":1,"week_index":2},{"is_warmup":false,"reps":1,"week_index":2},{"is_warmup":