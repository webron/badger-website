---
import HelpLayout from '../../layouts/HelpLayout.astro';

const personas = [
  {
    href: '/guides/just-lifting',
    title: 'I just want to lift',
    blurb: "You go to the gym and want to write it down. Log a set in under a minute, skip the jargon.",
  },
  {
    href: '/guides/program-runner',
    title: "I'm running a program",
    blurb: "You follow a set program. Build it once, have your weights waiting each session, and progress on autopilot.",
  },
  {
    href: '/guides/optimizer',
    title: 'Show me the data',
    blurb: "You want the numbers. PRs, strength trends, training volume, and when you have stalled.",
  },
  {
    href: '/guides/switching',
    title: "I'm switching from another app",
    blurb: "You have history in FitNotes, Strong, Hevy, or Stronglifts. Bring it over and feel at home fast.",
  },
];

// Not personas: these two answer a question someone arrives with rather than
// describing how they train, so they sit in their own group instead of being
// mixed into the picker above.
const more = [
  {
    href: '/guides/stronglifts-5x5-tracker',
    title: 'StrongLifts 5x5 in Badger',
    blurb:
      'The built-in 5x5 template, what you still decide yourself, and exactly what the CSV import carries across.',
  },
  {
    href: '/guides/fitnotes-alternative',
    title: 'Moving from FitNotes',
    blurb:
      'What the .fitnotes backup carries across (categories, library, body weight, measurements), and what you get that you did not have.',
  },
  {
    href: '/guides/workout-tracker-no-subscription',
    title: 'A tracker with no subscription',
    blurb:
      'What free means here, where Badger falls short, and how the other trackers charge. Competitors included.',
  },
];
---

<HelpLayout title="Starting guides" description="Pick the guide that matches how you train and get going with Badger in a few minutes.">
  <h1>Starting guides</h1>
  <p>Badger does a lot, but you do not need all of it on day one. Pick the description that sounds most like you and we will walk you through the parts that matter for how you train.</p>

  <div class="rule-ink guides-rule"></div>
  <ul class="guide-rows">
    {personas.map(p => (
      <li>
        <a class="guide-row" href={p.href}>
          <span class="guide-row__head">
            <span class="guide-row__title">{p.title}</span>
            <span class="guide-row__go">Read this guide &rarr;</span>
          </span>
          <span class="guide-row__blurb">{p.blurb}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="caps more-label">More guides</p>
  <ul class="guide-rows">
    {more.map(g => (
      <li>
        <a class="guide-row" href={g.href}>
          <span class="guide-row__head">
            <span class="guide-row__title">{g.title}</span>
            <span class="guide-row__go">Read this guide &rarr;</span>
          </span>
          <span class="guide-row__blurb">{g.blurb}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="guide-overview-link">Curious what else is in there? Browse <a href="/guides/overview">everything Badger does</a>, one line per feature.</p>
  <p class="guide-overview-link">Already paying for an AI? <a href="/guides/ai">Use your own AI</a> covers handing it your export or a routine file, with prompts to start from.</p>
</HelpLayout>

<style>
  /* The picker is a ledger now: a 2px ink top, then one ruled row per guide.
     "Read this guide" keeps its place as the row's right-aligned annotation
     rather than being dropped, since a restyle does not get to edit copy. */
  .guides-rule {
    margin-top: 22px;
  }

  .guide-rows {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
  }

  /* A caps label over a hairline: the same group heading the help sidebar index
     uses, rather than a second 2px ink rule. The ink rule marks the page's one
     ledger top; this is a subgroup inside it. */
  .more-label {
    margin: 0 0 2px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--hair);
    color: var(--text-muted);
  }

  .guide-row {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
  }

  .guide-row:hover {
    text-decoration: none;
  }

  .guide-row__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .guide-row__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .guide-row:hover .guide-row__title {
    color: var(--accent-ink);
  }

  .guide-row__go {
    flex: 0 0 auto;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent-ink);
    white-space: nowrap;
  }

  /* The pair does not fit side by side on a phone; the tail drops under the
     title rather than shredding it. Same reasoning as the homepage spread. */
  @media (max-width: 560px) {
    .guide-row__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }

  .guide-row__blurb {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
</style>
