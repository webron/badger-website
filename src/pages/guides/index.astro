---
import HelpLayout from '../../layouts/HelpLayout.astro';

const personas = [
  {
    href: '/guides/just-lifting/',
    title: 'I just want to lift',
    blurb: "You go to the gym and want to write it down. Log a set in under a minute, skip the jargon.",
  },
  {
    href: '/guides/program-runner/',
    title: "I'm running a program",
    blurb: "You follow a set program. Build it once, find your weights waiting each session, and let the program move them.",
  },
  {
    href: '/guides/optimizer/',
    title: 'Show me the data',
    blurb: "You want the numbers. PRs, strength trends, training volume, and when you have stalled.",
  },
  {
    href: '/guides/switching/',
    title: "I'm switching from another app",
    blurb: "You have history in FitNotes, Strong, Hevy, or StrongLifts. Bring it over, and see what carries across from yours.",
  },
];

// Not personas: each answers one question someone arrives with.
const questions = [
  {
    href: '/guides/stronglifts-5x5-tracker/',
    title: 'StrongLifts 5x5 in Badger',
    blurb:
      'The built-in 5x5 program, what you still decide yourself, and what the CSV import carries across.',
  },
  {
    href: '/guides/fitnotes-on-iphone/',
    title: 'FitNotes on iPhone',
    blurb:
      'There is no iPhone version of FitNotes. What to do with the log you already have when you switch phones.',
  },
  {
    href: '/guides/workout-tracker-no-subscription/',
    title: 'A tracker with no subscription',
    blurb:
      'What free means here, where Badger falls short, and how the other trackers charge.',
  },
  {
    href: '/guides/ai/',
    title: 'Use your own AI',
    blurb:
      'Hand an AI your export or a routine file, with prompts to start from, and import the routine it writes.',
  },
  {
    href: '/guides/overview/',
    title: 'Everything Badger does',
    blurb: 'Every feature, one line each, with a link to its help.',
  },
];

const groups = [
  { label: 'Start here', rows: personas },
  { label: 'Common questions', rows: questions },
];
---

<HelpLayout title="Guides" description="Pick the guide that matches how you train and get going with Badger in a few minutes.">
  <h1>Guides</h1>
  <p>You do not need all of Badger on day one. Pick the description that sounds most like you, and the guide covers the parts that matter for how you train.</p>

  <div class="rule-ink guides-rule"></div>
  {groups.map(g => (
    <>
      <p class="caps group-label">{g.label}</p>
      <ul class="guide-rows">
        {g.rows.map(r => (
          <li>
            <a class="guide-row" href={r.href}>
              <span class="guide-row__head">
                <span class="guide-row__title">{r.title}</span>
                <span class="guide-row__go">Read this guide &rarr;</span>
              </span>
              <span class="guide-row__blurb">{r.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}
</HelpLayout>

<style>
  /* The picker is a ledger now: a 2px ink top, then one ruled row per guide.
     "Read this guide" keeps its place as the row's right-aligned annotation
     rather than being dropped, since a restyle does not get to edit copy. */
  .guides-rule {
    margin-top: 22px;
  }

  .guide-rows {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
  }

  /* A caps label over a hairline: the same group heading the help sidebar index
     uses, rather than a second 2px ink rule. The ink rule marks the page's one
     ledger top; each group is a subgroup inside it. */
  .group-label {
    margin: 10px 0 2px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--hair);
    color: var(--text-muted);
  }

  .guide-row {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
  }

  .guide-row:hover {
    text-decoration: none;
  }

  .guide-row__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .guide-row__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .guide-row:hover .guide-row__title {
    color: var(--accent-ink);
  }

  .guide-row__go {
    flex: 0 0 auto;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent-ink);
    white-space: nowrap;
  }

  /* The pair does not fit side by side on a phone; the tail drops under the
     title rather than shredding it. Same reasoning as the homepage spread. */
  @media (max-width: 560px) {
    .guide-row__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }

  .guide-row__blurb {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
</style>
