---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

/**
 * The program gallery (M-web-4, spec: badger-fit
 * docs/superpowers/specs/2026-07-18-m-web-4-orphaned-pages.md section 1).
 *
 * Every file in public/programs/ was produced by the app's own routine export
 * (BadgerExportService) against a freshly seeded database, and each one was
 * imported back with the real import service and compared field by field.
 * Generator: badger-fit test/tools/program_gallery_export_test.dart. Regenerate
 * and re-copy whenever the schema or the seeded templates change.
 *
 * The counts and the app version below are read from the files at build time,
 * so this page cannot drift from what it is handing out.
 *
 * The closing section explains how the rule-bearing programs progress and
 * keeps one email link for program requests (the site counts page views and
 * nothing else, so an email is the only demand signal). What the downloadable
 * FILES carry is a separate question, answered by `ruleBearing` below rather
 * than by prose.
 */

// From the project root: at build time this module lives in dist/, so a
// module-relative path would resolve to a directory that does not exist.
const filesDir = join(process.cwd(), 'public/programs');

interface ProgramCopy {
  slug: string;
  title: string;
  level: string;
  cadence: string;
  blurb: string;
}

const programCopy: ProgramCopy[] = [
  {
    slug: 'stronglifts-5x5',
    title: 'StrongLifts 5x5',
    level: 'Beginner',
    cadence: '3 days a week',
    blurb:
      'Two sessions you alternate, five sets of five on the barbell lifts, and you add weight the moment you finish all your reps. In the app that is written as a rule you can read in one sentence, including the deload after three misses in a row and the 5x5 to 3x5 to 1x5 stall ladder it walks you down. It is the shortest route to a real squat, bench, row, press and deadlift, and it runs out somewhere around your first stubborn plateau.',
  },
  {
    slug: 'starting-strength',
    title: 'Starting Strength',
    level: 'Beginner',
    cadence: '3 days a week',
    blurb:
      'The same alternating shape as StrongLifts with three work sets instead of five, so each session is shorter and easier to recover from. In the app its rule drops the weight 10% when you stall and halves your increment on the way back up. It asks more of your technique and of how much you eat than of your schedule.',
  },
  {
    slug: 'full-body-3-day',
    title: 'Full Body',
    level: 'Beginner',
    cadence: '3 days a week',
    blurb:
      'One session, run three times a week, covering everything each time. A sensible pick when three days is all you have and you would rather not think about splits.',
  },
  {
    slug: 'gzclp',
    title: 'GZCLP',
    level: 'Late beginner',
    cadence: '4 days a week',
    blurb:
      'Three tiers a session: a heavy main lift, a lighter second movement, and accessory volume, rotating across four days. In the app the T1 and T2 stage ladders are written as a rule, so when a lift stalls Badger moves it to the next stage and says so, instead of leaving the bookkeeping to you.',
  },
  {
    slug: '531-bbb',
    title: '5/3/1 Boring But Big',
    level: 'Intermediate',
    cadence: '4 days a week',
    blurb:
      'One main lift a day over a four-week cycle: 5s, then 3s, then a 1+ single, then a lighter week, with five sets of ten of the same lift behind it. Every working set is a percentage of a training max rather than a weight, and Badger holds that number per lift, raises it at the end of a cycle, and holds it back if you missed the minimum on the way through. The first program here that is a wave rather than a ladder.',
  },
  {
    slug: 'nsuns-531lp',
    title: 'nSuns 531LP',
    level: 'Intermediate',
    cadence: '4 days a week',
    blurb:
      'A denser take on 5/3/1: nine working sets of the main lift, all percentage-based, with one marked as the set that decides what happens next. Hit enough reps on it and the training max goes up this week rather than at the end of a cycle. It asks for more work per session than anything else on this page.',
  },
  {
    slug: 'madcow-5x5',
    title: 'Madcow 5x5',
    level: 'Intermediate',
    cadence: '3 days a week',
    blurb:
      'The usual step after StrongLifts stops working: a heavy day, a light day and a medium day each week, with the lighter days written as percentages of the heavy one so the whole week moves together when the top set does. Progress is weekly instead of per session.',
  },
  {
    slug: 'upper-lower-4-day',
    title: 'Upper / Lower',
    level: 'Intermediate',
    cadence: '4 days a week',
    blurb:
      'Two heavy days and two lighter, higher-rep days across a four-day week. A reasonable next step when full-body sessions start taking an hour and a half.',
  },
  {
    slug: 'ppl-ul-5-day',
    title: 'Push / Pull / Legs + Upper / Lower',
    level: 'Intermediate',
    cadence: '5 days a week',
    blurb:
      'Push, pull and legs on the first three days, then an upper day and a lower day, with every set written as a rep range you work up through before you add weight. It is the usual answer to five days a week: more volume than upper/lower gives you, without asking for the sixth session that push/pull/legs does.',
  },
  {
    slug: 'ppl-6-day',
    title: 'Push / Pull / Legs',
    level: 'Intermediate',
    cadence: '6 days a week',
    blurb:
      'Push, pull and legs, run through twice, with one rest day. It only pays off if six sessions a week is realistic for you; at four or five, upper/lower does more with your time.',
  },
];

interface ProgramFile {
  sessions: number;
  exercises: number;
  sets: number;
  bytes: number;
  appVersion: string;
}

function readProgram(slug: string): ProgramFile {
  const raw = readFileSync(`${filesDir}/${slug}.badger`, 'utf8');
  const parsed = JSON.parse(raw);
  const days = parsed.payload.days as any[];
  const exercises = days.reduce((n, d) => n + d.exercises.length, 0);
  const sets = days.reduce(
    (n, d) => n + d.exercises.reduce((m: number, e: any) => m + e.predefined_sets.length, 0),
    0,
  );
  return {
    sessions: days.length,
    exercises,
    sets,
    bytes: Buffer.byteLength(raw, 'utf8'),
    appVersion: parsed.app_version,
  };
}

const programs = programCopy.map((p) => ({ ...p, file: readProgram(p.slug) }));
const appVersion = programs[0].file.appVersion;

// **Whether the DOWNLOADS carry rules is a fact about the files, not about the
// app, and the two moved apart.** A `.badger` file carries a rule as a
// `progression` object on a day exercise; the files in public/programs/ were
// exported from app 1.1.1 and carry none, while the app itself now runs them.
// So the claim is read off the files rather than written into the prose, and
// the copy below switches on it - the page cannot promise a rule it is not
// handing out.
//
// To make it true: regenerate with
//   flutter test test/tools/program_gallery_export_test.dart
// against a build that has both the rule seeds and the `.badger` rule keys,
// then copy build/program_gallery/*.badger into public/programs/.
const ruleBearing = programs.filter((p) =>
  readFileSync(`${filesDir}/${p.slug}.badger`, 'utf8').includes('"progression"'),
);
const filesCarryRules = ruleBearing.length > 0;
if (!filesCarryRules) {
  console.warn(
    '[programs.astro] None of the published .badger files carry a "progression" object. ' +
      'The page is rendering the app-only wording. Regenerate public/programs/*.badger ' +
      'from a rule-bearing build to hand the rules out with the files.',
  );
}

const fmtSize = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;

// How the rule-bearing programs progress, in four short cards. The detail
// lives on /help/progression/; each card links to its section there.
const progressCards = [
  {
    title: 'A rule you can read',
    href: '/help/progression/#rules',
    body: 'Each exercise in a program can carry one progression rule, written as a sentence. StrongLifts reads: "After 3 misses, drop 10%. When all working sets hit the plan, add 2.5 kg." Tap any number to change it. When Badger proposes a weight, it names the part of the rule that fired.',
  },
  {
    title: 'A training max, and percentages of it',
    href: '/help/progression/#training-max',
    body: "Badger keeps a training max for each lift: a number set a little below your one-rep max that never goes on the bar. Percentage sets are worked out from it and rounded to your own plates, bar and machine, so you can load what you read. A shared file carries the percentages, and whoever imports it sets their own training max.",
  },
  {
    title: 'AMRAP sets that drive the rule',
    href: '/help/progression/#driver-set',
    body: 'You can mark one set as the one that drives progression, usually an open-topped set like 5+. The reps you get on it decide what comes next. nSuns scales the increase by how many reps you get on your 5+ set; 5/3/1 adds a fixed amount at the end of each cycle instead, and holds it back if a week fell short.',
  },
  {
    title: 'Waved days',
    href: '/help/progression/#waves',
    body: "A day can run as a cycle of weeks, like 5/3/1's four. Each week's sets are written once, and the preview shows the right week when you train. Accessory work you do every week is written once and shows up in all of them.",
  },
];

const description =
  'Ten starter programs as .badger files you can import straight into Badger: StrongLifts 5x5, Starting Strength, full body, GZCLP, 5/3/1 Boring But Big, nSuns 531LP, Madcow 5x5, upper/lower, a five-day push/pull/legs and upper/lower hybrid, and six-day push/pull/legs. Six of them carry their own progression rules.';
---

<BaseLayout title="Program files" description={description}>
  <Header currentPath={Astro.url.pathname} />

  <main class="doc">
    <span class="kicker">Programs</span>
    <h1>Programs you can import</h1>
    <p class="lede">
      Each of these is a <code>.badger</code> file: a routine you download, open on your phone, and
      import into Badger in one step.
    </p>
    <p class="sub">
      All ten are also built into the app, under More &rarr; Routines, on a new install. Already
      using Badger? Programs added in an update don't appear in a routine list you already have, so
      import the file to get one.
    </p>
    <p class="sub">
      {
        filesCarryRules
          ? 'Where a program has a rule for what happens next session (drop 10% after three misses, add 2.5 kg when every set lands), the rule comes with the file.'
          : 'The files below carry sets, reps and structure. The progression rules that go with these programs are in the copies built into the app; the downloads here do not carry them yet.'
      }
    </p>
    <p class="sub">You can also use a file to:</p>
    <ul class="uses">
      <li>read a program before you commit to it</li>
      <li>edit it before you import it</li>
      <li>send it to a training partner</li>
      <li>
        give it to an AI as a worked example of the <a href="/badger-format/">file format</a> (the
        <a href="/guides/ai/">Use your own AI</a> guide has the prompts)
      </li>
    </ul>

    <div class="rule-ink section-rule"></div>
    <p class="caps section-label">Ten programs, ready to import</p>

    <ul class="programs">
      {
        programs.map((p) => (
          <li class="program">
            <div class="program-head">
              <h2>{p.title}</h2>
              <span class="program-tag">
                {p.level} &middot; {p.cadence}
              </span>
            </div>
            <p class="program-meta tnum">
              {p.file.sessions} {p.file.sessions === 1 ? 'session' : 'sessions'} &middot;{' '}
              {p.file.exercises} exercises &middot; {p.file.sets} sets &middot;{' '}
              {fmtSize(p.file.bytes)}
            </p>
            <p class="program-blurb">{p.blurb}</p>
            <p class="program-get">
              <a class="download" href={`/programs/${p.slug}.badger`} download>
                Download {p.slug}.badger
              </a>
            </p>
          </li>
        ))
      }
    </ul>

    <p class="note">
      Exported from Badger <span class="tnum">{appVersion}</span>, schema{' '}
      <code>share/v1</code>.
    </p>

    <div class="rule-ink section-rule"></div>
    <p class="caps section-label">How to import one</p>
    <ol class="steps">
      <li>Download the file on the phone you train with. It saves like any other download.</li>
      <li>
        Tap the file. Badger opens a preview showing the routine name, how many days it has, and which
        exercises it will add to your library. You can also open it from your file manager, or from
        Files on an iPhone.
      </li>
      <li>
        Tap Import. The routine appears under Routines, ready to start. Nothing you already have is
        overwritten: exercises you own are reused by name, and a routine with the same name as one of
        yours arrives as "(imported)".
      </li>
    </ol>
    <p class="note">
      More detail in <a href="/help/routines/#sharing">routines</a> and{' '}
      <a href="/help/settings/#data">your data</a>.
    </p>

    <div class="rule-ink section-rule"></div>
    <p class="caps section-label">How the programs progress</p>
    <p class="notyet-lede">
      Where a program has a rule for what happens next session, Badger runs it for you. Six of these
      programs come with their rules already set up in the app: <strong>StrongLifts 5x5</strong>,{' '}
      <strong>Starting Strength</strong>, <strong>GZCLP</strong>, <strong>5/3/1 BBB</strong>,{' '}
      <strong>nSuns 531LP</strong> and <strong>Madcow 5x5</strong>. The{' '}
      <a href="/badger-format/#progression">file format</a> lists the keys a rule is written with.
    </p>

    <ul class="programs">
      {
        progressCards.map((n) => (
          <li class="program">
            <div class="program-head">
              <h2>{n.title}</h2>
            </div>
            <p class="program-blurb">
              {n.body}{' '}
              <a href={n.href} aria-label={`${n.title}: more on the Progression help page`}>More</a>
            </p>
          </li>
        ))
      }
    </ul>

    <p class="note">
      Want a program that isn't here?{' '}
      <a href="mailto:hello@badger.fit?subject=Program%20request">Email hello@badger.fit</a> and say
      which one.
    </p>

    <div class="cta-min">
      <a class="btn-accent" href="/#download">Get the app</a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px 24px 0;
  }

  .kicker {
    display: block;
    margin-bottom: 10px;
  }

  .doc h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.15;
    color: var(--text);
  }

  .lede {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .sub {
    margin: 12px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .section-rule {
    margin-top: 42px;
  }

  .section-label {
    margin: 12px 0 0;
  }

  .programs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Ledger rows, not cards: a hairline under each program and nothing boxed. */
  .program {
    padding: 20px 0;
    border-bottom: 1px solid var(--hair);
  }

  .program-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  /* The program name is the entry's title, so it takes the serif. The numbers
     under it never do. */
  .program h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    color: var(--text);
  }

  .program-tag {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .program-meta {
    margin: 6px 0 0;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .program-blurb {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .program-get {
    margin: 10px 0 0;
  }

  .download {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent-ink) 45%, transparent);
  }

  .download:hover {
    text-decoration-color: var(--accent-ink);
  }

  .steps {
    margin: 14px 0 0 20px;
    padding: 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .steps li {
    margin-bottom: 8px;
  }

  .steps li::marker {
    color: var(--text-muted);
  }

  .note {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 62ch;
  }

  .uses {
    margin: 6px 0 0 20px;
    padding: 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .uses li::marker {
    color: var(--text-muted);
  }

  .notyet-lede {
    margin: 14px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  /* Every in-text link on the page, not a hand-listed few: color alone does not
     reach the 3:1 WCAG 1.4.1 wants against the body ink, so prose links carry a
     permanent underline (the M-web-0 house departure). Missing one is exactly
     what Lighthouse's link-in-text-block audit catches. */
  .doc p a,
  .doc li a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--accent-ink) 45%, transparent);
  }

  code {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--text);
  }

  .cta-min {
    text-align: center;
    margin-top: 30px;
  }

  /* The tag will not sit beside a wrapping title on a phone; it drops above it
     rather than squeezing the name, same as the guide rows. */
  @media (max-width: 560px) {
    .program-head {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 3px;
    }
  }

  @media (max-width: 640px) {
    .doc {
      padding: 44px 20px 0;
    }

    .doc h1 {
      font-size: 30px;
    }
  }
</style>
