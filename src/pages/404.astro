---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/**
 * The 404 page. Astro builds this to /404.html, which GitHub Pages serves for
 * any unknown path on the apex domain - that is the whole mechanism, there is
 * no config to set.
 *
 * It is noindex because GitHub serves this one file at every unknown URL, so
 * the canonical BaseLayout derives from the pathname would claim /404 for all
 * of them.
 *
 * Deliberately short. Someone here is lost, not browsing: name what happened,
 * then hand them the five places worth going. No app pitch - the CTA is on
 * every page they might land on next.
 */

const destinations = [
  { href: '/', label: 'Home', note: 'What Badger is, on one page.' },
  {
    href: '/help/',
    label: 'Help & documentation',
    note: 'Every feature written up, with a search field.',
  },
  { href: '/guides/', label: 'Starting guides', note: 'Short walkthroughs. Pick the one that sounds like you.' },
  { href: '/programs', label: 'Programs', note: 'The built-in programs and what each one asks of you.' },
  { href: '/glossary', label: 'Glossary', note: 'The words the app uses, defined.' },
];
---

<BaseLayout
  title="Page not found"
  description="That page is not here. Links to the rest of the Badger site."
>
  <meta name="robots" content="noindex" slot="head" />

  <Header currentPath={Astro.url.pathname} />

  <main class="doc">
    <span class="kicker">Error 404</span>
    <h1>That page is not here.</h1>
    <p class="lede">
      Either the link is wrong or the page has moved. Nothing is broken on your end.
    </p>

    <span class="caps">Where to go instead</span>
    <div class="rule-ink"></div>
    <ul class="dests">
      {
        destinations.map(({ href, label, note }) => (
          <li class="dest">
            <a class="dest-link" href={href}>
              {label}
            </a>
            <span class="dest-note">{note}</span>
          </li>
        ))
      }
    </ul>
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px 24px 0;
  }

  .kicker {
    display: block;
    margin-bottom: 10px;
  }

  .doc h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.15;
    color: var(--text);
  }

  .lede {
    margin: 14px 0 40px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 56ch;
  }

  .caps {
    display: block;
    margin-bottom: 6px;
  }

  /* A link row, not a ledger row: LedgerRow pairs a claim with a right-aligned
     annotation on one baseline, and these are destinations with a line of
     explanation under them. Same hairline and rhythm, different job. */
  .dests {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dest {
    padding: 13px 0;
    border-bottom: 1px solid var(--hair);
  }

  .dest-link {
    display: inline-block;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .dest-link:hover {
    text-decoration: underline;
  }

  .dest-note {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .doc {
      padding: 44px 20px 0;
    }

    .doc h1 {
      font-size: 30px;
    }
  }
</style>
