---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

/**
 * Unlisted review page for draft social posts. Not linked from anywhere, noindex,
 * left out of the sitemap (astro.config.mjs filter on /review/) and out of search
 * (data-pagefind-ignore). The route name is the access token: do not rename it
 * to something guessable, and do not add a Disallow line to robots.txt (that
 * would publish the path). Assets live in public/review/<same token>/.
 */
const token = '48130adc743ea98c';
const base = `/review/${token}`;

interface Post {
  slug: string;
  title: string;
  what: string;
  slides: number;
  flip?: boolean;
}

const series: Post[] = [
  {
    slug: 'program-look-531',
    title: '5/3/1 starts below your max',
    what: 'Series 1, program explainers: 5/3/1 in four steps (the training max, one workout, four weeks, when the max goes up), drawn as bars and boxes. Rebuilt 2026-11-15 for pace.',
    slides: 5,
    flip: true,
  },
  {
    slug: 'app-intro-how-to',
    title: 'Pick it. Start it. Log it.',
    what: 'Series 2, app how-to: three steps to start a program and log a first set, over a real screen recording. Rebuilt 2026-11-15 for a first-time viewer: 47 s, each screen held before the circled tap.',
    slides: 5,
  },
  {
    slug: 'math-look-top-set',
    title: 'The week 3 top set',
    what: 'Series 3, training math: what the 5/3/1 week 3 sets weigh from a 100 kg training max, with a counting number and rulers.',
    slides: 5,
    flip: true,
  },
  {
    slug: 'myths-look-train-at-max',
    title: 'Myth: train at your max',
    what: 'Series 4, myths and mistakes: the myth first, then why 5/3/1 stays below what you could lift once.',
    slides: 6,
  },
];

const firstRound: Post[] = [
  {
    slug: 'gzclp-stage-failures',
    title: 'GZCLP stage failures',
    what: 'How the GZCLP main lift moves from 5x3 to 6x2 to 10x1 after misses, and what happens after the last stage.',
    slides: 5,
  },
  {
    slug: '531-training-max',
    title: '5/3/1: the training max is not your max',
    what: 'What a training max is, how each set is a percent of it, and how it moves once per cycle.',
    slides: 5,
  },
  {
    slug: 'app-intro',
    title: 'What Badger does',
    what: 'A log that runs your program, in four screens: log, program, adjust and progress, with demo data.',
    slides: 6,
  },
];

const groups = [
  { heading: 'Series looks', note: 'Four posts, one for each series look.', posts: series },
  { heading: 'First round', note: 'The earlier samples, built before the series looks.', posts: firstRound },
];

const range = (n: number) => Array.from({ length: n }, (_, i) => i + 1);
---

<BaseLayout
  title="Sample posts for review"
  description="Draft social posts for review."
  noindex
>
  <div data-pagefind-ignore>
    <Header currentPath={Astro.url.pathname} />

    <main class="review">
      <span class="kicker">Drafts for review</span>
      <h1>Sample posts</h1>
      <p class="lede">
        These are drafts. Please look at the look and the pace. Each post has a reel
        (a short video) and a carousel (swipe sideways to go through the slides). Note anything
        that is confusing or hard to read, and where on the screen or in the video it happens.
      </p>
      <p class="lede">
        The reels are silent on purpose: music is added in Instagram when a post goes out. None
        of these has been posted.
      </p>

      {
        groups.map((group) => (
          <section class="group">
            <h2>{group.heading}</h2>
            <p class="group-note">{group.note}</p>

            {group.posts.map((post) => (
              <article class="post" id={post.slug}>
                <h3>{post.title}</h3>
                <p class="what">{post.what}</p>

                <p class="label">Reel</p>
                <video
                  class="reel"
                  controls
                  playsinline
                  preload="metadata"
                  width="720"
                  height="1280"
                  poster={`${base}/${post.slug}/poster.jpg`}
                  src={`${base}/${post.slug}/reel.mp4`}
                >
                  Your browser can't play this video.
                </video>

                <p class="label">Carousel, {post.slides} slides</p>
                <div class="strip" tabindex="0" role="group" aria-label={`${post.title} carousel`}>
                  {range(post.slides).map((n) => (
                    <figure class="slide">
                      <img
                        src={`${base}/${post.slug}/slide-${n}.jpg`}
                        width="1080"
                        height="1350"
                        loading="lazy"
                        decoding="async"
                        alt={`${post.title}, slide ${n} of ${post.slides}`}
                      />
                      <figcaption class="tnum">{n} / {post.slides}</figcaption>
                    </figure>
                  ))}
                </div>

                {post.flip && (
                  <>
                    <p class="label">Alternate cover</p>
                    <div class="strip" tabindex="0" role="group" aria-label={`${post.title} alternate cover`}>
                      <figure class="slide">
                        <img
                          src={`${base}/${post.slug}/flip-1.jpg`}
                          width="1080"
                          height="1350"
                          loading="lazy"
                          decoding="async"
                          alt={`${post.title}, alternate cover`}
                        />
                        <figcaption>Alternate cover</figcaption>
                      </figure>
                    </div>
                  </>
                )}
              </article>
            ))}
          </section>
        ))
      }
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .review {
    max-width: 720px;
    margin: 0 auto;
    padding: 28px 16px 64px;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    margin: 6px 0 14px;
  }

  .lede {
    margin: 0 0 12px;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.55;
  }

  .group {
    margin-top: 40px;
  }

  .group h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 4px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }

  .group-note {
    margin: 0 0 8px;
    color: var(--text-muted);
    font-size: 14px;
  }

  .post {
    margin-top: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--hair);
  }

  .post:last-child {
    border-bottom: 0;
  }

  .post h3 {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 6px;
  }

  .what {
    margin: 0 0 4px;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .label {
    margin: 20px 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .reel {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    aspect-ratio: 9 / 16;
    margin: 0 auto;
    background: var(--panel);
    border-radius: 10px;
    object-fit: contain;
  }

  /* Swipe strip. It bleeds to the screen edges (the page gutter is 16px), so the
     next slide peeks at the right on a phone. Slides are 82% of the viewport,
     capped so they stay a sensible size on a tablet or desktop. */
  .strip {
    display: flex;
    gap: 12px;
    margin: 0 -16px;
    padding: 0 16px 4px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .slide {
    flex: 0 0 min(82vw, 360px);
    margin: 0;
    scroll-snap-align: start;
  }

  .slide img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    background: var(--panel);
    border-radius: 8px;
    border: 1px solid var(--hair);
  }

  .slide figcaption {
    margin-top: 6px;
    font-size: 13px;
    color: var(--text-muted);
    text-align: center;
  }

  @media (min-width: 760px) {
    /* The column stops growing at 720px, so the strip no longer reaches the
       screen edge: keep its bleed inside the column. */
    .strip {
      margin: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
    }
  }
</style>
