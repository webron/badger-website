  <ul>
    <li><a href={`/help/getting-started/#importing`}>Import from FitNotes, Strong, Hevy or StrongLifts</a>.</li>
    <li><a href={`/help/settings/#backup`}>Back up and restore</a>.</li>
    <li><a href={`/help/phone-migration/`}>Move to a new phone</a>.</li>
    <li><a href={`/help/settings/#export`}>Export your sets to CSV</a>.</li>
    <li><a href={`/help/settings/`}>Change a setting</a>.</li>
  </ul>

