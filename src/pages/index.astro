---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreBadges from '../components/StoreBadges.astro';
import HomeScreen from '../components/home/HomeScreen.astro';
import RestBar from '../components/home/RestBar.astro';
import '../styles/home.css';
import { APP_STORE_URL, PLAY_URL } from '../store-links';

// Kept at or under 165 characters: Google truncates the displayed snippet at
// roughly that width, and this string is the snippet, the og:description and
// the schema description all at once. Measure before editing.
const description =
  'Badger is a workout and strength tracker for Android and iOS. Log a set and the rest timer starts, the plates are counted and your program picks the weights.';

// The four importers. They link to the guide for each app: these pages answer a
// question someone arrives with, and a crawler reads internal links from the
// homepage as a statement of what matters on the site.
const importers = [
  { href: '/guides/fitnotes-alternative/', app: 'FitNotes' },
  { href: '/guides/strong-alternative/', app: 'Strong' },
  { href: '/guides/hevy-alternative/', app: 'Hevy' },
  { href: '/guides/moving-from-stronglifts/', app: 'StrongLifts' },
];

const ORG_ID = 'https://badger.fit/#organization';

// One @graph rather than two <script> blocks, so the app node can point at the
// organization node by @id instead of restating it.
//
// Every claim here has to be true of the shipped product. sameAs carries the two
// store listings: they are the public profile pages that are actually ours.
// Badger has no social accounts, and inventing them would be the exact kind of
// unverifiable markup that gets structured data ignored. The App Store page
// joined the list on 2026-09-09; the retired TestFlight invite never did, since
// a join link is not a profile.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'Badger',
      // "Badger" alone is an animal, a US state mascot and a meter company, and
      // the site currently ranks around #32 for its own name. alternateName is
      // the field schema.org provides for exactly this: it states the name
      // people actually mean without turning every page title into keyword
      // stuffing. It does not fix ranking on its own; authority does that.
      alternateName: 'Badger workout tracker',
      url: 'https://badger.fit',
      logo: 'https://badger.fit/assets/badger_logo_stacked.svg',
      sameAs: [PLAY_URL, APP_STORE_URL],
    },
    {
      // MobileApplication is a subtype of SoftwareApplication and is the more
      // accurate of the two: Badger ships as a phone app and nothing else.
      '@type': 'MobileApplication',
      name: 'Badger',
      applicationCategory: 'HealthApplication',
      // Both operating systems now have a public store listing: the App Store
      // release went live 2026-09-09 (1.1.10, build 28), fifteen days after
      // submission. downloadUrl takes one URL, so it keeps Play, the older and
      // larger listing; the App Store page is reachable through sameAs and the
      // CTA below, which now names both stores in plain words.
      operatingSystem: 'Android, iOS',
      url: 'https://badger.fit',
      downloadUrl: [APP_STORE_URL, PLAY_URL],
      description,
      publisher: { '@id': ORG_ID },
      // Genuinely free: no paid tier, no in-app purchase, nothing paywalled.
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  ],
};
---

<BaseLayout
  title="Badger"
  fullTitle="Badger - Workout & strength tracker that handles the rest"
  description={description}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

  <Header currentPath={Astro.url.pathname} />

  <main class="home">
    <section class="hero">
      <div class="wrap">
        <div class="hero-copy">
          <div class="eyebrow">Workout &amp; strength tracker &middot; Android &amp; iOS</div>
          <div>
            <!-- The space before the break is collapsed on screen but keeps the two
                 sentences apart in the text content, so the heading does not read as
                 "set.Badger" to a screen reader or a crawler. -->
            <h1>Log the set. <br /><span class="it">Badger handles the&nbsp;rest.</span></h1>
            <div class="stripe"></div>
          </div>
          <p class="lede">
            Save a set and the rest timer starts. The plates are counted, last session's numbers
            sit above the next set, and programs like 5/3/1 and StrongLifts work out what goes on
            the bar.
          </p>
          <div class="hero-badges">
            <StoreBadges id="download" />
          </div>
          <ul class="facts">
            <li>No account needed</li>
            <li>Works offline</li>
          </ul>
        </div>

        <div class="stage">
          <HomeScreen
            hero
            name="training"
            alt="Training screen for Flat Barbell Bench Press with the sets already logged below the weight and reps boxes"
          />
          <div class="pop lockchip" aria-hidden="true">
            <b>LOCK SCREEN</b>&minus;15 s &middot; +15 s &middot; Skip, without opening the app
          </div>
          <RestBar />
        </div>
      </div>
    </section>

    <section class="rule">
      <div class="wrap">
        <div class="head center">
          <div class="eyebrow">At the bar</div>
          <h2>Between sets, <span class="it">it does the math.</span></h2>
          <div class="stripe"></div>
        </div>
        <div class="scenes">
          <div class="scene">
            <div class="stage">
              <HomeScreen
                name="tools"
                alt="Plate calculator showing 225 lbs on a 45 lb bar, with the plates for each side"
              />
              <div class="pop tag" style="bottom: 10%" aria-hidden="true">
                45 bar + 90 each side<small>1 &times; 55 &middot; 1 &times; 35 per side</small>
              </div>
            </div>
            <h3>Plates, counted.</h3>
            <p>
              Type 225 and see what goes on each side, from the plates your gym has. Barbell,
              machine or single-lever.
            </p>
          </div>
          <div class="scene">
            <div class="stage">
              <HomeScreen
                name="set_timer"
                alt="Set timer counting down 47 seconds for a plank"
              />
              <div class="pop tag" style="top: 30%" aria-hidden="true">
                Spoken countdown<small>plays over your music</small>
              </div>
            </div>
            <h3>Timed sets, out loud.</h3>
            <p>
              Planks and holds get a countdown you can hear, so the phone stays on the floor. It
              keeps going with the screen locked.
            </p>
          </div>
          <div class="scene">
            <div class="stage">
              <HomeScreen
                name="program_day"
                alt="Bench day of a 5/3/1 style program with every set's weight filled in"
              />
              <div class="pop tag" style="top: 24%" aria-hidden="true">
                190 lbs &times; 1+<small>from your training max</small>
              </div>
            </div>
            <h3>Today's weights, ready.</h3>
            <p>Start a program day and every set already has its weight. Tick them off as you go.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rule">
      <div class="wrap">
        <div class="split">
          <div class="stage">
            <HomeScreen
              name="progress_pr"
              alt="Bench press progress overview: an estimated one-rep max of 306, last session's top set, and a chart of the past year with the personal record marked"
            />
            <div
              class="pop tag"
              style="top: 21%; left: auto; right: -34px; width: 150px"
              aria-hidden="true"
            >
              PR<small>best est. 1RM 326.8</small>
            </div>
          </div>
          <div class="copy">
            <div class="eyebrow">After the workout</div>
            <h2>Watch your <span class="it">strength climb.</span></h2>
            <div class="stripe"></div>
            <p>
              Every exercise gets a chart and its records. The summary puts today next to last
              time, lift by lift.
            </p>
            <ul class="ticks">
              <li>Estimated 1RM, heaviest set, rep records</li>
              <li>Records kept per gym and per machine</li>
              <li>Weekly muscle balance</li>
            </ul>
          </div>
        </div>
        <div class="split flip">
          <div class="stage">
            <HomeScreen
              name="stall"
              alt="Workout B with the back squat's stage changed after three misses in a row"
            />
            <div class="pop tag" style="top: 45%" aria-hidden="true">
              Stage 2 of 3<small>3 misses in a row, plan changed</small>
            </div>
          </div>
          <div class="copy">
            <div class="eyebrow">When a lift stalls</div>
            <h2>Miss a lift, <span class="it">the plan adjusts.</span></h2>
            <div class="stripe"></div>
            <p>
              Programs follow their own rules for a stall: change the rep scheme, deload, or reset
              the training max. You see what changed and why before you start.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="rule">
      <div class="wrap center" style="display: grid; gap: 14px; justify-items: center">
        <div class="eyebrow">Switching?</div>
        <h2>Bring your history <span class="it">with you.</span></h2>
        <div class="stripe"></div>
        <p class="lede">Import your log from these four apps and pick up where you left off.</p>
        <ul class="imports">
          {importers.map((i) => <li><a href={i.href}>{i.app}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="cta">
      <div class="wrap">
        <h2>Your next session, <span class="it">sorted.</span></h2>
        <div class="stripe"></div>
        <StoreBadges lazy />
        <p class="small">
          Free on Android and iOS. Your log stays on your phone.
          <a href="/promise/">Read the Badger promise</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
