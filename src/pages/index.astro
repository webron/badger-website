---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreBadges from '../components/StoreBadges.astro';
import PositioningStrip from '../components/PositioningStrip.astro';
import PhoneFrameBand from '../components/PhoneFrameBand.astro';
import FeatureRow from '../components/FeatureRow.astro';
import LedgerRow from '../components/LedgerRow.astro';
import ArrowGlyph from '../components/ArrowGlyph.astro';

const description =
  'Badger is a workout and strength tracker for Android and iOS. As capable as the big trackers, as private as a notebook. No account needed, no subscription, works offline.';

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Badger',
  applicationCategory: 'HealthApplication',
  // M-web-3 CHECK: operatingSystem claims iOS, but the iOS build is
  // TestFlight-only today. Re-check this against the actual store status at
  // launch and update it together with the CTA's iOS clause below
  // (spec section 8 milestone M-web-3, copy worklist section 1).
  operatingSystem: 'Android, iOS',
  url: 'https://badger.fit',
  downloadUrl: 'https://play.google.com/store/apps/details?id=fit.badger.app',
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const positioning = [
  { value: 'No account needed', detail: 'no sign-up, no login' },
  { value: 'No subscription', detail: 'free, no caps' },
  { value: 'Works offline', detail: 'basement-gym proof' },
  { value: 'Your data stays yours', detail: 'on your phone, export anytime' },
];

// Copy: docs/2026-07-16-copy-worklist.md section 1 (feature ledger), verbatim.
// Grid fills row-first, so this order is left, right, left, right down the page.
const features = [
  {
    glyph: 'barbell',
    title: 'Logging that keeps up',
    body: 'Weight, reps, time, distance, whatever the exercise needs. Warmup sets, RPE, RIR, tempo, and per-set notes included.',
  },
  {
    glyph: 'stopwatch',
    title: 'Rest timer',
    body: 'Auto-starts after each working set. Per-exercise defaults, live countdown on your lock screen, sound or vibration.',
  },
  {
    glyph: 'program',
    title: 'Routines and programs',
    body: 'Build your own or start from 7 built-in programs (StrongLifts, 5/3/1, PPL, and more). Supersets, scheduled days, predefined sets.',
  },
  {
    glyph: 'trend',
    title: 'Progress you can read',
    body: 'PR detection for every exercise type, estimated 1RM, 11 graphs per exercise, activity heatmap, weekly volume by muscle group.',
  },
  {
    glyph: 'gym',
    title: 'Your gym, modeled',
    body: 'Track which gym and which machine every set was done on. Machine-scoped PRs, real weight increments, attachments and grips.',
  },
  {
    glyph: 'plate',
    title: 'Plate calculator',
    body: 'Barbell, machine, and single-lever modes. Finds the best combination from the plates your gym actually has.',
  },
  {
    glyph: 'compare',
    title: 'Planned vs. actual',
    body: 'Finish a routine workout and the summary shows what you hit against what the plan asked for, set by set.',
  },
  {
    glyph: 'import',
    title: 'Bring your history',
    body: 'Import from FitNotes, Strong, Hevy, or StrongLifts. Export every set to CSV or back up the full database anytime.',
  },
  {
    glyph: 'wave',
    title: 'Deload, handled',
    body: 'Optional deload detection by time, RPE, or stalled lifts. Reduces the load for a week and never lets it drag your next session down.',
  },
  {
    glyph: 'shield',
    title: 'Backup on your terms',
    body: 'Automatic backup to a private folder in your own Google Drive, or a plain file you keep wherever you like. Optional, off by default.',
  },
] as const;

const shouldDo = [
  { label: 'Unlimited routines, unlimited history', annotation: 'no free-tier caps' },
  { label: 'Full-depth set logging', annotation: 'RPE · RIR · tempo · warmups' },
  { label: 'PRs and graphs for every exercise type', annotation: 'est. 1RM included' },
  { label: 'Per-gym equipment and machine tracking', annotation: 'machine-scoped PRs' },
  { label: 'Plate calculator and warmup generator', annotation: 'your plates, your increments' },
  { label: 'Imports from four other trackers', annotation: 'FitNotes · Strong · Hevy · StrongLifts' },
];

const shouldnt = [
  { label: 'No account needed', annotation: 'no sign-up, no login, no email' },
  { label: 'No subscription', annotation: 'free, nothing paywalled' },
  { label: 'No ads, no data collection', annotation: "your training is nobody's product" },
  { label: 'No connection needed', annotation: 'fully offline, syncs with nothing' },
  { label: 'No lock-in', annotation: 'export everything, anytime' },
  { label: 'No streak guilt', annotation: 'no XP, no badges, no nagging' },
];
---

<BaseLayout
  title="Badger"
  fullTitle="Badger - Workout & Strength Tracker for Android & iOS"
  description={description}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appJsonLd)} />

  <Header currentPath={Astro.url.pathname} />

  <main>
    <section class="hero">
      <span class="kicker">Workout &amp; strength tracker &middot; Android &amp; iOS</span>

      <!-- The space before the break is collapsed on screen but keeps the two
           sentences separated in the text content, so the heading does not read
           as "trackers.As private" to a screen reader or a crawler. -->
      <h1>As capable as the big trackers. <br />As private as a notebook.</h1>

      <p class="hero-sub">
        Badger logs your sets, runs your programs, and tracks your PRs, and it keeps all of it on
        your phone. No account needed, no subscription, no ads.
      </p>

      <div class="hero-badges">
        <StoreBadges id="download" />
      </div>

      <a class="docs-link" href="/help/getting-started">
        Read the docs <ArrowGlyph />
      </a>

      <PositioningStrip items={positioning} />
    </section>

    <PhoneFrameBand />

    <section class="block">
      <h2 class="caps section-label">What's in the app</h2>
      <div class="rule-ink section-rule"></div>

      <ul class="features">
        {features.map((f) => <FeatureRow glyph={f.glyph} title={f.title} body={f.body} />)}
      </ul>
    </section>

    <section class="block">
      <div class="spread">
        <div class="spread-col">
          <div class="rule-ink"></div>
          <h2>Everything a tracker should do</h2>
          <ul>
            {shouldDo.map((r) => <LedgerRow label={r.label} annotation={r.annotation} />)}
          </ul>
        </div>

        <div class="spread-col">
          <div class="rule-ink"></div>
          <h2>Nothing a tracker shouldn't</h2>
          <ul>
            {shouldnt.map((r) => <LedgerRow label={r.label} annotation={r.annotation} />)}
          </ul>
        </div>
      </div>
    </section>

    <section class="promise-teaser">
      <p class="teaser-line">Your data is yours. That is the whole business model.</p>
      <a class="teaser-link" href="/promise">
        Read the Badger promise <ArrowGlyph />
      </a>
    </section>

    <section class="cta">
      <h2>Ready to start?</h2>
      <p>Badger is free on Google Play, with an iOS beta open in TestFlight.</p>
      <StoreBadges />
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---- hero ---- */

  .hero {
    padding: 68px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1.18;
    max-width: 30ch;
    color: var(--text);
  }

  .hero-sub {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 58ch;
  }

  /* A wrapper this page owns, rather than a class handed to StoreBadges: Astro
     does not extend a parent's style scope onto a child component's root, so a
     scoped .store-badges rule from here would never match. */
  .hero-badges {
    margin-top: 6px;
  }

  .docs-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .docs-link:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* ---- sections ---- */

  .block {
    padding: 60px 24px 0;
  }

  .section-label {
    display: block;
    max-width: 1012px;
    margin: 0 auto 6px;
  }

  .section-rule {
    max-width: 1012px;
    margin: 0 auto;
  }

  /* ---- feature ledger ---- */

  .features {
    max-width: 1012px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 56px;
  }

  /* ---- capable / shouldn't spread ---- */

  .spread {
    max-width: 1012px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }

  .spread h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 18px;
    color: var(--text);
    padding: 14px 0 10px;
  }

  .spread ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---- promise teaser ---- */

  .promise-teaser {
    text-align: center;
    padding: 68px 24px 4px;
  }

  .teaser-line {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: var(--text);
  }

  .teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .teaser-link:hover {
    text-decoration: underline;
  }

  /* ---- CTA ---- */

  .cta {
    max-width: 1012px;
    margin: 64px auto 0;
    padding: 28px 24px 8px;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 24px;
    color: var(--text);
  }

  .cta p {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-secondary);
    max-width: 46ch;
  }

  /* The spread's widest pair ("Plate calculator and warmup generator" against
     "your plates, your increments") needs ~430px to hold one line, so two
     columns only earn their keep from about 1000px up. Below that they are
     narrower than the content and the labels shred into three ragged lines,
     which is what the mockup does at tablet width. One wide column instead:
     still a ledger, still label-left annotation-right, just readable. */
  @media (max-width: 1000px) {
    .spread {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 44px 20px 32px;
    }

    .block {
      padding: 52px 20px 0;
    }

    .features {
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    .promise-teaser {
      padding: 56px 20px 4px;
    }

    .teaser-line {
      font-size: 20px;
    }

    .cta {
      margin-top: 52px;
      padding: 28px 20px 8px;
    }
  }
</style>
