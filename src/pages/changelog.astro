---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Keep this in sync with the in-app changelog
// (badger-fit: lib/features/about/domain/changelog.dart) and the store
// release notes. Newest first.
const releases = [
  {
    version: '1.1.0',
    date: 'July 2026',
    headline: 'Badger looks like a training log now',
    highlights: [
      'A complete redesign: paper and slate, ruled entries instead of cards, and tally marks for your sets. It reads like a field journal.',
      'Your set progress now inks in as you complete each set, right above the set list.',
      'Every exercise row leads with its equipment mark, so you can find a lift by shape as much as by name.',
      'Personal records are marked with a flag you can spot at a glance, and a stamp on the summary when you set an all-time best.',
      'Muscle maps throughout: what an exercise works, what a routine covers, and where your volume actually went.',
      'History reads as entries: tap one to open it, with the week at a glance up top.',
      'Charts redrawn on graph paper, with your all-time best marked as a line to beat.',
      'Rest timer on the iPhone lock screen and Dynamic Island.',
    ],
  },
  {
    version: '1.0.12',
    date: 'July 2026',
    headline: 'Supersets everywhere, and records for every lift',
    highlights: [
      'Redesigned supersets: create a group once, edit it in one place, and set it up the same way in a live workout, a routine, or past history.',
      'Personal records now work for every exercise type, not just weight × reps - timed holds, distances, reps-only, and more.',
      'On iPhone, the rest timer now shows on your lock screen and Dynamic Island.',
      'Workout summaries compare what you planned against what you actually lifted.',
      'Configurable warm-up set generator with per-exercise overrides.',
    ],
  },
  {
    version: '1.0.11',
    date: 'June 2026',
    highlights: [
      'Fixed a unit bug where lbs users could see weights in kg.',
      'Deload weeks no longer carry their reduced weights into the next session.',
      'Log a past workout from the calendar, with a timer-free backdated flow.',
    ],
  },
  {
    version: '1.0.10',
    date: 'May 2026',
    highlights: [
      'Editable history: tap any logged set to correct it after the fact.',
      'Machine-scoped exercise notes and per-machine weight configuration.',
      'Share gyms, machines, and routines as .badger files.',
    ],
  },
];
---

<BaseLayout
  title="Changelog"
  description="What's new in Badger - a release-by-release list of features, improvements, and fixes."
>
  <Header currentPath={Astro.url.pathname} />

  <main class="doc">
    <span class="kicker">Release log</span>
    <h1>What's new</h1>
    <p class="lede">
      Every release of Badger, newest first. Badger is in active development on Android and in beta
      on iOS.
    </p>

    {
      releases.map((r, i) => (
        <article class="release">
          <div class="release-head">
            <h2>Version {r.version}</h2>
            {i === 0 && <span class="release-latest">Latest</span>}
            <span class="release-date">{r.date}</span>
          </div>

          {r.headline && <p class="release-headline">{r.headline}</p>}

          <ul class="release-notes">
            {r.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px 24px 0;
  }

  .kicker {
    display: block;
    margin-bottom: 10px;
  }

  .doc h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.15;
    color: var(--text);
  }

  .lede {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 56ch;
  }

  /* Each release is a journal entry, the same shape the promise page uses: a 2px
     ink rule opens it, and the card it used to live in is gone. */
  .release {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }

  .release-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* The version is the entry's heading, so it takes the serif. The numerals in
     it are part of a title, not data being compared down a column. */
  .release-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    color: var(--text);
  }

  .release-latest {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .release-date {
    margin-left: auto;
    font-size: 13px;
    color: var(--text-muted);
  }

  .release-headline {
    margin: 8px 0 0;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text);
  }

  .release-notes {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .release-notes li {
    padding: 9px 0;
    border-bottom: 1px solid var(--hair);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .doc {
      padding: 44px 20px 0;
    }

    .doc h1 {
      font-size: 30px;
    }

    /* The date has no room to sit opposite the version at phone width. */
    .release-date {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
