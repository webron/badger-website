---
/**
 * The frame chrome for a phone-sized illustration: 1.5px ink border, radius 26,
 * ground fill.
 *
 * Placeholder era (spec section 5): what sits inside is an honest schematic of
 * the journal UI, not a screenshot and not a screenshot pastiche. Deliberately
 * no status bar, no notch, no home indicator, no device bezel: the frame says
 * "phone-shaped illustration" and stops there. M-web-3 swaps the whole band for
 * real captures once the app redesign ships.
 */
interface Props {
  /** The middle frame stands slightly taller in the band. */
  big?: boolean;
  class?: string;
}

const { big = false, class: className } = Astro.props;
---

<div class:list={['phone', { big }, className]}>
  <div class="phone-inner">
    <span class="phone-stripe"></span>
    <slot />
  </div>
</div>

<style>
  .phone {
    width: 218px;
    border: 1.5px solid var(--ink);
    border-radius: 26px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 10px 34px rgba(38, 34, 25, 0.14);
  }

  .phone.big {
    width: 244px;
  }

  .phone-inner {
    padding: 14px 14px 18px;
  }

  /* The frame is its own region, so it carries its own stripe. Thinner bands
     than the page chrome: this is a 218px-wide illustration of a 6px motif. */
  .phone-stripe {
    display: block;
    height: 5px;
    margin: 2px 0 12px;
    background:
      linear-gradient(var(--ink), var(--ink)) top / 100% 1.5px no-repeat,
      linear-gradient(var(--accent), var(--accent)) bottom / 100% 1.5px no-repeat,
      transparent;
  }

  /* Two frames share the row at phone width, the taller one keeping its edge. */
  @media (max-width: 640px) {
    .phone {
      width: 46%;
    }

    .phone.big {
      width: 50%;
    }
  }
</style>
