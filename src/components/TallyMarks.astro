---
/**
 * Set tally sticks, the app's set-progress mark.
 *
 * Decorative on the site: these appear only inside the phone-frame
 * illustrations and never as real UI (spec section 5). Done sticks take the
 * accent fill; todo sticks are outlined in the disabled token, which is allowed
 * precisely because nothing here is copy.
 */
interface Props {
  done?: number;
  todo?: number;
}

const { done = 0, todo = 0 } = Astro.props;
---

<span class="tally">
  {Array.from({ length: done }).map(() => <i class="done" />)}
  {Array.from({ length: todo }).map(() => <i class="todo" />)}
</span>

<style>
  .tally {
    display: inline-flex;
    gap: 3.5px;
    align-items: center;
  }

  .tally i {
    display: inline-block;
    width: 3.5px;
    height: 13px;
    border-radius: 1px;
    transform: skewX(-12deg);
  }

  .tally i.done {
    background: var(--accent);
  }

  .tally i.todo {
    background: transparent;
    border: 1px solid var(--text-disabled);
  }
</style>
