---
/**
 * A ledger row: label on the left, muted annotation right-aligned on the same
 * baseline, hairline rule underneath. Used by the capable/shouldn't spread.
 */
interface Props {
  label: string;
  annotation: string;
}

const { label, annotation } = Astro.props;
---

<li class="ledger-row">
  <span class="ledger-label">{label}</span>
  <span class="ledger-annotation">{annotation}</span>
</li>

<style>
  .ledger-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--hair);
  }

  .ledger-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .ledger-annotation {
    font-size: 12.5px;
    color: var(--text-muted);
    text-align: right;
    white-space: nowrap;
  }

  /* Below ~560px the longest annotations ("FitNotes · Strong · Hevy ·
     StrongLifts") hold a nowrap column wide enough to squeeze their label into
     three ragged lines. Stacking the pair keeps both readable and keeps the
     label dominant. The mockup has no viewport meta, so its own 640px rules
     never rendered at phone width; this is the same layout, resolved. */
  @media (max-width: 560px) {
    .ledger-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1px;
    }

    .ledger-annotation {
      text-align: left;
      white-space: normal;
    }
  }
</style>
