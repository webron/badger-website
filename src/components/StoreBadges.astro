---
/**
 * The two store affordances, used in the hero and again in the closing CTA.
 *
 * Both marks are the store owner's own supplied artwork and ship as the files
 * they are: Google's PNG, and Apple's black "Download on the App Store" SVG
 * pulled from Apple's marketing toolbox. Neither follows the site theme tokens.
 * They are third-party trademarks, not journal chrome, so they keep their own
 * fixed colors in light and dark alike.
 *
 * Apple's App Store Marketing Guidelines drive four things here, and none of
 * them are cosmetic preferences to tune later:
 *
 *  - The App Store badge comes FIRST when badges for other platforms are in the
 *    same layout. That is why Apple is the first child and Google the second.
 *  - The preferred black badge is the one to use whenever another platform's
 *    badge is present. The gray hairline around it is part of the artwork.
 *  - Minimum clear space is one quarter of the badge height, which is the 10px
 *    padding below (40 / 4). Nothing may sit inside it.
 *  - Minimum height onscreen is 40px. The artwork is authored at exactly 40, so
 *    it renders at its native size and is never recolored, angled or animated.
 *
 * Using the badge also obliges an Apple trademark credit line, which lives once
 * in the site footer next to the other legal notices.
 *
 * Both hrefs come from src/store-links.ts. The App Store one is still a
 * placeholder there and has to be filled in before any of this is deployed.
 *
 * The Play badge sits in a 56px box whose PNG carries about 16% built-in
 * padding, so its visible button is roughly 37.6px tall. Apple's 40px lands
 * within a couple of pixels of that, which is why the pair reads as balanced
 * despite the different box heights.
 */
import { APP_STORE_URL, PLAY_URL } from '../store-links';

interface Props {
  /** Only the hero instance takes the #download target the header links to. */
  id?: string;
}

const { id } = Astro.props;
---

<div class="store-badges" id={id}>
  <a class="badge-apple" href={APP_STORE_URL} data-store-event="store-appstore">
    <!-- Apple's artwork, unmodified. Intrinsic 119.66407x40; the width and
         height attributes let the browser reserve the box before the SVG
         arrives, which is what keeps CLS at 0. -->
    <img
      src="/assets/badges/app-store-badge.svg"
      alt="Download on the App Store"
      width="120"
      height="40"
    />
  </a>

  <a class="badge-play" href={PLAY_URL} data-store-event="store-play">
    <!-- Intrinsic 646x250. The attributes are what let the browser reserve the
         box before the PNG arrives, which is what keeps CLS at 0. -->
    <img
      src="/assets/badges/google-play-badge.png"
      alt="Get it on Google Play"
      width="646"
      height="250"
    />
  </a>

</div>

<script>
  // Count taps on the two store affordances as GoatCounter events. This is the
  // one number the page view count cannot give us: whether the site actually
  // sends anyone to a store. It records that a click happened, nothing about who
  // clicked. The component renders twice per page, so this delegates from the
  // document rather than binding per badge, and Astro hoists it once either way.
  //
  // Everything is guarded: if count.js is blocked or still loading, the click
  // proceeds untracked. Navigation is never delayed or blocked on the beacon.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const link = target?.closest?.('[data-store-event]');
    if (!link) return;

    const gc = (window as any).goatcounter;
    if (!gc?.count) return;

    gc.count({
      path: link.getAttribute('data-store-event'),
      title: 'Store link click',
      event: true,
    });
  });
</script>

<style>
  .store-badges {
    display: flex;
    /* Column gap is small because both marks carry padding of their own: Apple's
       required clear space below, and the padding baked into Google's PNG. */
    column-gap: 6px;
    row-gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .badge-apple,
  .badge-play {
    display: inline-flex;
    text-decoration: none;
  }

  .badge-apple:hover,
  .badge-play:hover {
    text-decoration: none;
  }

  /* 10px is Apple's minimum clear space: one quarter of the 40px badge height.
     Don't reduce it, and don't let anything be placed inside it. */
  .badge-apple {
    padding: 10px;
  }

  .badge-apple img {
    display: block;
    height: 40px;
    width: auto;
  }

  .badge-play img {
    display: block;
    height: 56px;
    width: auto;
  }
</style>
