---
/**
 * The two store affordances, used in the hero and again in the closing CTA.
 *
 * Both badges are the store's own supplied artwork and ship as the images they
 * are. Apple's identity guidelines require the provided App Store badge rather
 * than a recreated lockup, which is what the hand-drawn TestFlight pill here
 * was until the App Store release on 2026-09-09. Both keep their own fixed
 * colors: they are third-party marks, not journal chrome, and they do not
 * follow the theme tokens.
 */
interface Props {
  /** Only the hero instance takes the #download target the header links to. */
  id?: string;
}

const { id } = Astro.props;

const PLAY_URL = 'https://play.google.com/store/apps/details?id=fit.badger.app';
const APP_STORE_URL = 'https://apps.apple.com/app/id6782743069';
---

<div class="store-badges" id={id}>
  <a class="badge-play" href={PLAY_URL} data-store-event="store-play">
    <!-- Intrinsic 646x250. The attributes are what let the browser reserve the
         box before the PNG arrives, which is what keeps CLS at 0. -->
    <img
      src="/assets/badges/google-play-badge.png"
      alt="Get it on Google Play"
      width="646"
      height="250"
    />
  </a>

  <a class="badge-appstore" href={APP_STORE_URL} data-store-event="store-appstore">
    <!-- Apple's supplied badge artwork, unmodified. Intrinsic 119.66x40; the
         width/height attributes reserve the box so this badge costs no CLS
         either. -->
    <img
      src="/assets/badges/app-store-badge.svg"
      alt="Download on the App Store"
      width="120"
      height="40"
    />
  </a>
</div>

<script>
  // Count taps on the two store affordances as GoatCounter events. This is the
  // one number the page view count cannot give us: whether the site actually
  // sends anyone to a store. It records that a click happened, nothing about who
  // clicked. The component renders twice per page, so this delegates from the
  // document rather than binding per badge, and Astro hoists it once either way.
  //
  // Everything is guarded: if count.js is blocked or still loading, the click
  // proceeds untracked. Navigation is never delayed or blocked on the beacon.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const link = target?.closest?.('[data-store-event]');
    if (!link) return;

    const gc = (window as any).goatcounter;
    if (!gc?.count) return;

    gc.count({
      path: link.getAttribute('data-store-event'),
      title: 'Store link click',
      event: true,
    });
  });
</script>

<style>
  .store-badges {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .badge-play,
  .badge-appstore {
    display: inline-flex;
    text-decoration: none;
  }

  .badge-play:hover,
  .badge-appstore:hover {
    text-decoration: none;
  }

  .badge-play img {
    display: block;
    height: 56px;
    width: auto;
  }

  /* Google's PNG carries about 10% of transparent padding inside its box and
     Apple's SVG carries none, so 56px of Play badge is roughly 45px of visible
     button. The two are matched on what the eye sees, not on equal boxes -
     Apple's guidelines ask that their badge is never the smaller of the pair. */
  .badge-appstore img {
    display: block;
    height: 45px;
    width: auto;
  }
</style>
