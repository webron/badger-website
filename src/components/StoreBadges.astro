---
/**
 * The two store affordances, used in the hero and again in the closing CTA.
 *
 * The Play badge is Google's supplied artwork and has to ship as the PNG it is;
 * the TestFlight pill is drawn locally so it stays on Apple's black-chrome
 * convention without pulling a second image over the wire. Both keep their own
 * fixed colors: they are third-party marks, not journal chrome, and they do not
 * follow the theme tokens.
 */
interface Props {
  /** Only the hero instance takes the #download target the header links to. */
  id?: string;
}

const { id } = Astro.props;

const PLAY_URL = 'https://play.google.com/store/apps/details?id=fit.badger.app';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/wqxnbujx';
---

<div class="store-badges" id={id}>
  <a class="badge-play" href={PLAY_URL}>
    <!-- Intrinsic 646x250. The attributes are what let the browser reserve the
         box before the PNG arrives, which is what keeps CLS at 0. -->
    <img
      src="/assets/badges/google-play-badge.png"
      alt="Get it on Google Play"
      width="646"
      height="250"
    />
  </a>

  <a class="badge-testflight" href={TESTFLIGHT_URL} aria-label="Try the iOS beta on TestFlight">
    <svg width="15" height="18" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true" focusable="false">
      <path
        d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
      ></path>
    </svg>
    <span class="tf-lines" aria-hidden="true">
      <span class="tf-kicker">Try the</span>
      <span class="tf-name">iOS beta</span>
    </span>
  </a>
</div>

<style>
  .store-badges {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .badge-play,
  .badge-testflight {
    display: inline-flex;
    text-decoration: none;
  }

  .badge-play:hover,
  .badge-testflight:hover {
    text-decoration: none;
  }

  .badge-play img {
    display: block;
    height: 56px;
    width: auto;
  }

  /* Apple's mark keeps Apple's chrome: black ground, hairline edge, white type,
     in both site themes. */
  .badge-testflight {
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 6px;
    color: #fff;
  }

  .tf-lines {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .tf-kicker {
    font-size: 8px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    opacity: 0.85;
    line-height: 1.2;
  }

  .tf-name {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.05;
  }
</style>
