---
import Stripe from './Stripe.astro';
import InstagramGlyph from './InstagramGlyph.astro';
import { footerGroups } from '../lib/wayfinding.mjs';
import { INSTAGRAM_URL } from '../store-links';

// Three rows: Learn, Badger, Legal. Names come from src/lib/wayfinding.mjs so the
// footer says what the header and the sidebar say. ".badger file format" is here so a
// reader (or an agent) starting from any page can reach the .badger spec, which
// the header does not link.
const groups = footerGroups;

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <Stripe mini />

    <nav class="footer-links" aria-label="Footer">
      {
        groups.map((g) => (
          <div class="footer-row">
            <span class="footer-row-label">{g.label}</span>
            <span class="footer-row-links">
              {g.links.map(({ href, label }) => (
                <a href={href}>{label}</a>
              ))}
            </span>
          </div>
        ))
      }
      <!-- Off-site, so not in footerGroups (whose entries must be pages of this site). -->
      <div class="footer-row footer-row-follow">
        <span class="footer-row-label">Follow</span>
        <span class="footer-row-links">
          <a class="footer-social" href={INSTAGRAM_URL} rel="noopener" aria-label="Badger on Instagram"
            ><InstagramGlyph size={32} /></a
          >
        </span>
      </div>
    </nav>

    <p class="footer-copy">&copy; {year} Badger. All rights reserved.</p>

    <!-- Apple's App Store Marketing Guidelines require a trademark credit line
         wherever the App Store badge is used, crediting both Apple and the Apple
         logo, and require it exactly once per website. This is that once. Google
         asks the same of the Play badge, so both lines sit here together, beside
         the Privacy and Terms links, which is where legal notices belong. Do not
         add a second copy on another page. -->
    <p class="footer-trademarks">
      Apple, the Apple logo and iPhone are trademarks of Apple Inc., registered in the U.S. and
      other countries and regions. App Store is a service mark of Apple Inc. Google Play and the
      Google Play logo are trademarks of Google LLC.
    </p>

    <!-- AppTierList listing badge, as generated by AppTierList. Their verifier
         looks for this exact link and image in the server-rendered home page.
         It is visible on purpose: no hidden or off-screen links. The image loads
         from apptierlist.com, which the privacy page says. -->
    <a
      class="footer-badge"
      href="https://apptierlist.com/apps/badger-gym-workout-tracker-6782743069/?from=badge"
      rel="noopener"
    ><img
      src="https://apptierlist.com/badge/badger-gym-workout-tracker-6782743069.svg?k=atl-i76e3c"
      alt="Badger: Gym Workout Tracker on AppTierList"
      width="116"
      height="32"
      loading="lazy"
    /></a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hair);
    margin-top: 88px;
    padding: 36px 24px 44px;
  }

  .footer-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 22px;
  }

  /* The row name is a quiet caps label, not a link. */
  .footer-row-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    min-width: 4.5em;
    text-align: right;
  }

  .footer-row-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 22px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* The glyph link. Instagram's rules ask for clear space of half the glyph's width
     (16px at 32px) on every side: the 8px padding plus the row gaps around it give
     that, and the padding makes a 48px tap target. No hover recolor: the glyph must
     stay as drawn, so the pointer and the focus ring are the only feedback. */
  .footer-row-follow {
    align-items: center;
  }

  .footer-links a.footer-social {
    display: inline-block;
    padding: 8px;
    line-height: 0;
    border-radius: 10px;
  }

  .footer-links a.footer-social svg {
    display: block;
  }

  .footer-copy {
    margin: 0;
    font-size: 12px;
    color: var(--text-muted);
  }

  .footer-trademarks {
    margin: 0;
    max-width: 64ch;
    text-align: center;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .footer-badge {
    display: inline-block;
    line-height: 0;
    min-height: 32px;
  }

  .footer-badge img {
    display: block;
    width: 116px;
    height: 32px;
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 30px 20px 36px;
    }

    .footer-row,
    .footer-row-links {
      gap: 4px 16px;
    }

    .footer-row {
      flex-direction: column;
      align-items: center;
    }

    /* Stacked, the label sits above the glyph: 8px here plus the link's 8px padding
       keeps the 16px clear space. */
    .footer-row-follow {
      row-gap: 8px;
    }
  }
</style>
