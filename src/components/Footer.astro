---
import Stripe from './Stripe.astro';

// "The promise" (/promise) is built in M-web-1 and 404s until then. The link is
// wired now so the footer index is complete when that page lands.
const links = [
  { href: '/', label: 'Home' },
  { href: '/help', label: 'Help' },
  { href: '/guides', label: 'Guides' },
  { href: '/programs', label: 'Programs' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/promise', label: 'The promise' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/legal/terms', label: 'Terms' },
];

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <Stripe mini />

    <nav class="footer-links" aria-label="Footer">
      {links.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <p class="footer-copy">&copy; {year} Badger. All rights reserved.</p>

    <!-- Apple's App Store Marketing Guidelines require a trademark credit line
         wherever the App Store badge is used, crediting both Apple and the Apple
         logo, and require it exactly once per website. This is that once. Google
         asks the same of the Play badge, so both lines sit here together, beside
         the Privacy and Terms links, which is where legal notices belong. Do not
         add a second copy on another page. -->
    <p class="footer-trademarks">
      Apple, the Apple logo and iPhone are trademarks of Apple Inc., registered in the U.S. and
      other countries and regions. App Store is a service mark of Apple Inc. Google Play and the
      Google Play logo are trademarks of Google LLC.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hair);
    margin-top: 88px;
    padding: 36px 24px 44px;
  }

  .footer-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .footer-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .footer-copy {
    margin: 0;
    font-size: 12px;
    color: var(--text-muted);
  }

  .footer-trademarks {
    margin: 0;
    max-width: 64ch;
    text-align: center;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 30px 20px 36px;
    }

    .footer-links {
      gap: 16px;
    }
  }
</style>
