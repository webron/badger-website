---
import Stripe from './Stripe.astro';

// "File format" is here so a reader (or an agent) starting from any page can
// reach the .badger spec, which the header does not link.
const links = [
  { href: '/', label: 'Home' },
  { href: '/help/', label: 'Help' },
  { href: '/guides/', label: 'Guides' },
  { href: '/programs/', label: 'Programs' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/badger-format/', label: 'File format' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/promise/', label: 'The promise' },
  { href: '/about/', label: 'About' },
  { href: '/about/#contact', label: 'Contact' },
  { href: '/legal/privacy/', label: 'Privacy' },
  { href: '/legal/terms/', label: 'Terms' },
];

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <Stripe mini />

    <nav class="footer-links" aria-label="Footer">
      {links.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <p class="footer-copy">&copy; {year} Badger. All rights reserved.</p>

    <!-- Apple's App Store Marketing Guidelines require a trademark credit line
         wherever the App Store badge is used, crediting both Apple and the Apple
         logo, and require it exactly once per website. This is that once. Google
         asks the same of the Play badge, so both lines sit here together, beside
         the Privacy and Terms links, which is where legal notices belong. Do not
         add a second copy on another page. -->
    <p class="footer-trademarks">
      Apple, the Apple logo and iPhone are trademarks of Apple Inc., registered in the U.S. and
      other countries and regions. App Store is a service mark of Apple Inc. Google Play and the
      Google Play logo are trademarks of Google LLC.
    </p>

    <!-- AppTierList listing badge, as generated by AppTierList. Their verifier
         looks for this exact link and image in the server-rendered home page.
         It is visible on purpose: no hidden or off-screen links. The image loads
         from apptierlist.com, which the privacy page says. -->
    <a
      class="footer-badge"
      href="https://apptierlist.com/apps/badger-gym-workout-tracker-6782743069/?from=badge"
      rel="noopener"
    ><img
      src="https://apptierlist.com/badge/badger-gym-workout-tracker-6782743069.svg?k=atl-i76e3c"
      alt="Badger: Gym Workout Tracker on AppTierList"
      width="116"
      height="32"
      loading="lazy"
    /></a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hair);
    margin-top: 88px;
    padding: 36px 24px 44px;
  }

  .footer-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .footer-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .footer-copy {
    margin: 0;
    font-size: 12px;
    color: var(--text-muted);
  }

  .footer-trademarks {
    margin: 0;
    max-width: 64ch;
    text-align: center;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .footer-badge {
    display: inline-block;
    line-height: 0;
    min-height: 32px;
  }

  .footer-badge img {
    display: block;
    width: 116px;
    height: 32px;
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 30px 20px 36px;
    }

    .footer-links {
      gap: 16px;
    }
  }
</style>
