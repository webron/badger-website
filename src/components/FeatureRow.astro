---
import FeatureGlyph from './FeatureGlyph.astro';
import type { GlyphName } from './feature-glyphs';

/**
 * One row of the feature ledger: leading line glyph, title, body. Hairline
 * bottom rule, no box. The glyph is the constant leading mark, same as the
 * app's exercise ledger rows.
 */
interface Props {
  glyph: GlyphName;
  title: string;
  /**
   * Rendered as HTML so a body can carry an inline link to the page that
   * documents the feature. Author-supplied copy only, never user input, so
   * there is nothing here to escape against - but keep bare & < > out of it.
   */
  body: string;
}

const { glyph, title, body } = Astro.props;
---

<li class="feature-row">
  <FeatureGlyph name={glyph} />
  <div>
    <h3>{title}</h3>
    <p set:html={body} />
  </div>
</li>

<style>
  .feature-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 17px 0;
    border-bottom: 1px solid var(--hair);
    /* Accent as an icon takes the ink variant, never raw petrol. */
    color: var(--accent-ink);
  }

  .feature-row h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .feature-row p {
    margin: 2px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Same treatment as .prose p a in global.css, for the same reason: petrol
     against body ink does not clear the 3:1 WCAG 1.4.1 asks of a color-only
     affordance, so a link inside a paragraph carries a permanent rule rather
     than color alone. :global because the anchor arrives through set:html and
     so never gets this component's scoping attribute. */
  .feature-row p :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--accent-ink) 45%, transparent);
  }

  .feature-row p :global(a:hover) {
    text-decoration-color: var(--accent-ink);
  }
</style>
