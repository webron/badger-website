---
import BadgerMark from './BadgerMark.astro';
import Stripe from './Stripe.astro';
import { mainNav, searchHref, strip } from '../lib/wayfinding.mjs';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const path = strip(currentPath);
const navLinks = mainNav.map((l) => ({ ...l, active: l.match(path) }));
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main">
    <a class="wordmark" href="/">
      <BadgerMark height={26} />
      <span class="wordmark-text">Badger</span>
    </a>

    <div class="nav-right">
      {
        navLinks.map(({ href, label, active }) => (
          <a
            class:list={['nav-link', { active }]}
            href={href}
            aria-current={active ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }

      <a class="btn-accent" href="/#download">Get the app</a>

      <!-- Phone menu: a native disclosure, so it works without script and keeps
           keyboard and screen-reader behavior. Shown at 640px and below, where
           the four links above do not fit. The small script below only closes it. -->
      <details class="nav-menu">
        <summary class="nav-menu-btn">
          <span>Menu</span>
          <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false">
            <polyline points="6 9 12 15 18 9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></polyline>
          </svg>
        </summary>
        <div class="nav-menu-panel">
          <ul>
            {
              navLinks.map(({ href, label, active }) => (
                <li>
                  <a
                    class:list={['nav-menu-link', { active }]}
                    href={href}
                    aria-current={active ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
            <li class="nav-menu-search">
              <a class="nav-menu-link" href={searchHref}>Search help and guides</a>
            </li>
          </ul>
        </div>
      </details>

      <button id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>
<Stripe class="header-stripe" />

<script is:inline>
  // Close the phone menu on a link tap (a same-page link such as Search on the
  // help index does not reload), on Escape, on a tap outside, and when the page
  // is restored from the back/forward cache.
  (function () {
    var menu = document.querySelector('.nav-menu');
    if (!menu) return;
    var close = function () {
      menu.removeAttribute('open');
    };
    menu.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a')) close();
    });
    document.addEventListener('click', function (e) {
      if (!menu.contains(e.target)) close();
    });
    menu.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.hasAttribute('open')) {
        close();
        var s = menu.querySelector('summary');
        if (s) s.focus();
      }
    });
    window.addEventListener('pageshow', close);
  })();

  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ??
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const next = current === 'light' ? 'dark' : 'light';
    const apply = () => {
      if (window.__setTheme) window.__setTheme(next);
      else root.setAttribute('data-theme', next);
    };
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
    // Animate through a view transition where the browser has one; elsewhere,
    // and under reduced motion, the theme simply switches.
    if (
      typeof document.startViewTransition === 'function' &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      document.startViewTransition(apply);
    } else {
      apply();
    }
  });
</script>

<style>
  /* Ground, not a raised surface. The stripe below supplies the edge, so the
     header carries no border of its own. */
  .site-header {
    background: var(--bg);
  }

  .site-nav {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  /* Serif is structure: the wordmark is a title, not data. The mockup pairs the
     type with a mini stripe underline; with the icon restored (Ron's call) that
     underline would put a second stripe element in the header region, which the
     motif rule forbids, so the full-width band below is the only stripe here. */
  .wordmark-text {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 21px;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* .btn-accent itself is a shared primitive in global.css (the promise page's
     closing CTA uses the same button). */

  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: 1px solid var(--outline);
    border-radius: 8px;
    color: var(--text-secondary);
    cursor: pointer;
  }

  #theme-toggle:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  /* The phone menu is hidden above 640px, where the links fit. */
  .nav-menu {
    display: none;
  }

  .site-nav {
    position: relative;
  }

  .nav-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 10px;
    list-style: none;
    cursor: pointer;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid var(--outline);
    border-radius: 8px;
    user-select: none;
  }

  .nav-menu-btn::-webkit-details-marker {
    display: none;
  }

  .nav-menu-btn:hover,
  .nav-menu[open] .nav-menu-btn {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .nav-menu-btn svg {
    transition: transform 0.15s ease;
  }

  .nav-menu[open] .nav-menu-btn svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu-btn svg {
      transition: none;
    }
  }

  .nav-menu-btn:focus-visible,
  .nav-menu-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Opens as a sheet under the bar, spanning the content width. */
  .nav-menu-panel {
    position: absolute;
    z-index: 60;
    top: calc(100% + 4px);
    left: 20px;
    right: 20px;
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(38, 34, 25, 0.28);
    padding: 6px 0;
  }

  .nav-menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu-link {
    display: block;
    padding: 12px 18px;
    font-size: 15px;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  .nav-menu-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-menu-link.active {
    color: var(--accent-ink);
    font-weight: 600;
    border-left-color: var(--accent);
  }

  .nav-menu-search {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--hair);
  }

  /* Under 640px the links do not fit beside the wordmark, button and toggle,
     so they move into the Menu disclosure. The footer carries the full index. */
  @media (max-width: 640px) {
    .site-nav {
      padding: 0 20px;
    }

    .nav-menu {
      display: block;
    }

    .nav-link {
      display: none;
    }

    .nav-right {
      gap: 12px;
    }
  }

  /* Below the 320px reflow line (folded foldables), the row above runs 17px
     wide and pushes the theme toggle off-screen. Tighten the spacing rather
     than drop the button; 320px and up is untouched. */
  @media (max-width: 319.98px) {
    .site-nav {
      padding: 0 16px;
      gap: 10px;
    }

    .nav-right {
      gap: 8px;
    }

    .btn-accent {
      padding-inline: 12px;
    }
  }
</style>
