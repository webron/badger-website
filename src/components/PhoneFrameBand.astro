---
import PhoneFrame from './PhoneFrame.astro';
import TallyMarks from './TallyMarks.astro';

/**
 * The homepage phone band, placeholder era.
 *
 * Three schematic illustrations of the journal UI: a day's ledger, a live set
 * log, and a progress read. They are drawings of the design language (stripe,
 * serif date, ledger rows, tally sticks, one hero number, PR flag), not
 * screenshots and not dressed up as screenshots. The caption says so out loud.
 *
 * M-web-3 replaces this whole component with real captures from the app repo's
 * demo/marketing pipeline, which is why the band is one file: the swap is a
 * single import away.
 *
 * The illustrations are presentational to assistive tech (role="img" on the row
 * makes the subtree so). Everything they depict is stated in words by the
 * feature ledger below them.
 */
const FRAMES_LABEL =
  "Schematic illustrations of Badger's journal interface: a day's exercise list with set tally marks, a live set log with a rest timer and a personal-record flag, and an estimated one-rep-max graph with weekly volume by muscle group.";
---

<figure class="frames">
  <div class="frames-row" role="img" aria-label={FRAMES_LABEL}>
    <PhoneFrame>
      <span class="ph-date">Tuesday, July 14</span>
      <span class="ph-caps">Today</span>
      <span class="ph-rule"></span>

      <div class="ph-row">
        <span class="ph-name">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M3 12h18M6 8v8M18 8v8M9 10v4M15 10v4"></path>
          </svg>
          Squat
        </span>
        <TallyMarks done={3} todo={2} />
      </div>

      <div class="ph-row">
        <span class="ph-name">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M3 12h18M6 8v8M18 8v8M9 10v4M15 10v4"></path>
          </svg>
          Bench Press
        </span>
        <TallyMarks todo={3} />
      </div>

      <div class="ph-row">
        <span class="ph-name">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M4 17c3-1 5-4 8-4s5 3 8 4M12 13V7m-3 0h6"></path>
          </svg>
          Barbell Row
        </span>
        <TallyMarks todo={3} />
      </div>

      <p class="ph-hero tnum">
        1:12:40
        <small>This week &middot; 3 workouts</small>
      </p>
    </PhoneFrame>

    <PhoneFrame big>
      <span class="ph-date">Squat</span>
      <span class="ph-caps">Working sets</span>
      <span class="ph-rule"></span>

      <div class="ph-row">
        <span class="ph-name tnum">1 &nbsp; 110 kg &times; 5</span>
        <TallyMarks done={1} />
      </div>

      <div class="ph-row">
        <span class="ph-name tnum">2 &nbsp; 110 kg &times; 5</span>
        <TallyMarks done={1} />
      </div>

      <div class="ph-row">
        <span class="ph-name tnum">3 &nbsp; 112.5 kg &times; 5</span>
        <span class="ph-pr">PR</span>
      </div>

      <div class="ph-row">
        <span class="ph-name tnum muted">4 &nbsp; 112.5 kg &times; 5</span>
        <TallyMarks todo={1} />
      </div>

      <p class="ph-hero tnum">
        2:31
        <small>Rest &middot; set 4 of 4</small>
      </p>
    </PhoneFrame>

    <PhoneFrame>
      <span class="ph-date">Progress</span>
      <span class="ph-caps">Est. 1RM &middot; Squat</span>
      <span class="ph-rule"></span>

      <p class="ph-hero tnum tight">131 kg</p>

      <svg class="ph-graph" width="100%" height="88" viewBox="0 0 190 88" preserveAspectRatio="none">
        <line x1="0" y1="22" x2="190" y2="22" stroke="var(--hair)" stroke-width="1"></line>
        <line x1="0" y1="44" x2="190" y2="44" stroke="var(--hair)" stroke-width="1"></line>
        <line x1="0" y1="66" x2="190" y2="66" stroke="var(--hair)" stroke-width="1"></line>
        <path
          d="M4 74 L34 66 L64 58 L94 46 L124 40 L154 28 L186 18 L186 88 L4 88 Z"
          fill="var(--accent)"
          opacity="0.12"></path>
        <path
          d="M4 74 L34 66 L64 58 L94 46 L124 40 L154 28 L186 18"
          fill="none"
          stroke="var(--accent)"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <circle cx="154" cy="28" r="4" fill="var(--bg)" stroke="var(--ink)" stroke-width="2"></circle>
        <circle cx="186" cy="18" r="3.5" fill="var(--accent)"></circle>
      </svg>

      <span class="ph-caps">Muscles this week</span>
      <span class="ph-rule"></span>

      <div class="ph-row">
        <span class="ph-name">Legs</span>
        <span class="ph-name tnum muted">24 sets</span>
      </div>

      <div class="ph-row">
        <span class="ph-name">Back</span>
        <span class="ph-name tnum muted">18 sets</span>
      </div>
    </PhoneFrame>
  </div>

  <figcaption>preview frames &middot; swapped for real screenshots when the app redesign ships</figcaption>
</figure>

<style>
  .frames {
    margin: 0;
    padding: 44px 24px 0;
  }

  .frames-row {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 28px;
  }

  figcaption {
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    padding: 14px 0 0;
  }

  /* ---- schematic interior ---- */

  .ph-date {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 14.5px;
    color: var(--text);
  }

  .ph-caps {
    display: block;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-top: 12px;
  }

  /* The ledger section top, at illustration scale. */
  .ph-rule {
    display: block;
    height: 1.5px;
    background: var(--ink);
    margin: 3px 0 2px;
  }

  .ph-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid var(--hair);
  }

  .ph-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    /* Exercise names and set figures are data: sans, never the serif. */
  }

  .ph-name svg {
    color: var(--text-secondary);
    flex: 0 0 auto;
  }

  .ph-name.muted {
    color: var(--text-muted);
  }

  /* The PR flag: ink block, accent keyline under it. Reads on any accent. */
  .ph-pr {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.04em;
    background: var(--ink);
    color: var(--bg);
    padding: 1px 5px;
    border-radius: 2px;
    border-bottom: 2px solid var(--accent);
  }

  /* One hero number per frame. */
  .ph-hero {
    margin: 12px 0 0;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
  }

  .ph-hero.tight {
    margin-top: 8px;
  }

  .ph-hero small {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .ph-graph {
    display: block;
    margin-top: 8px;
  }

  @media (max-width: 640px) {
    .frames {
      padding: 32px 12px 0;
    }

    .frames-row {
      gap: 14px;
    }

    /* Two frames is the story at phone width; the third would be unreadable.
       Its content is fully covered by the feature ledger, and the row's
       aria-label describes the band rather than counting frames. */
    .frames-row > :global(*:nth-child(3)) {
      display: none;
    }
  }
</style>
