---
/**
 * The positioning strip: a ledger band under the hero. 2px ink rule on top,
 * hairline underneath, hairline verticals between cells. Wraps to 2x2 on phones.
 *
 * Every claim here is phrased as never-required / opt-in per spec section 1.3.
 */
interface Props {
  items: { value: string; detail: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['strip', className]}>
  {
    items.map(({ value, detail }) => (
      <li class="strip-cell">
        <span class="strip-value">{value}</span>
        <span class="strip-detail">{detail}</span>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    max-width: 940px;
    width: 100%;
    margin: 26px auto 0;
    padding: 0;
    list-style: none;
    display: flex;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--hair);
  }

  .strip-cell {
    flex: 1;
    padding: 15px 10px 13px;
    text-align: center;
  }

  .strip-cell + .strip-cell {
    border-left: 1px solid var(--hair);
  }

  .strip-value {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
  }

  .strip-detail {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* 2x2. The verticals move to the second column and a hairline opens between
     the rows, so the grid keeps reading as one ruled band. */
  @media (max-width: 640px) {
    .strip {
      flex-wrap: wrap;
    }

    .strip-cell {
      flex: 1 1 50%;
      border-left: none;
    }

    .strip-cell:nth-child(even) {
      border-left: 1px solid var(--hair);
    }

    .strip-cell:nth-child(n + 3) {
      border-top: 1px solid var(--hair);
    }
  }
</style>
