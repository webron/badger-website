      { href: `/help/settings`, label: 'Settings overview' },
      { href: `/help/settings#logging`, label: 'Logging settings' },
      { href: `/help/settings#coaching`, label: 'Coaching settings' },
      { href: `/help/settings#app`, label: 'App settings' },
      { href: `/help/settings#data`, label: 'Your data' },
