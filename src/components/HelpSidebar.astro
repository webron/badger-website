---

<aside id="help-sidebar">
  <!-- Search pinned at top - never scrolls away -->
  <div class="help-search-wrap">
    <Search id="help-search" uiOptions={{ showImages: false, showSubResults: false, excerptLength: 12, pageSize: 20 }} />
  </div>
  <!-- Nav: scrolls independently on desktop, collapsible on mobile -->
  <details id="help-nav-details" open>
    <summary class="help-nav-toggle">
      <span class="help-nav-toggle-label">Browse help topics</span>
      <svg class="help-nav-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </summary>
    <nav id="help-sidebar-nav">
    {nav.map(section => (
      <div class="sgroup">
        <p class="caps sgroup-label">{section.label}</p>
        <ul>
          {section.items.map(item => {
            // Exact match only. Comparing against the href with its hash stripped
            // marked every anchor item on the current page active at once, so
            // /help/logging lit up all four of its rows and the keyline ran down
            // the group as one accent block. Astro sees no fragment server-side,
            // so this resolves to exactly one row per page: the page's own entry.
            const active = currentPath === item.href;
            return (
              <li>
                <a
                  class:list={['sgroup-link', { active }]}
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
    </nav>
  </details>
</aside>

<style is:global>
  /* Pagefind UI theme - mapped to the journal tokens. */
  #help-search {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-primary: var(--accent-ink);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--outline);
    --pagefind-ui-tag: var(--panel);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: inherit;
  }

  /* The search field is a ruled line, not a box: pagefind ships a pill input, so
     the box has to be unset explicitly rather than just re-colored. It also
     pins an explicit height off --pagefind-ui-scale, which leaves a lot of dead
     air around a 13px field; height:auto hands sizing back to the padding.
     .help-search-wrap reserves the resulting height, so re-measure it if any of
     these numbers move. */
  #help-search .pagefind-ui__search-input {
    height: auto;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--outline);
    border-radius: 0;
    padding: 7px 2px 7px 22px;
    font-size: 13px;
    font-weight: 400;
    color: var(--text);
  }

  /* Pagefind draws the magnifier as an absolutely-positioned pseudo-element
     inset for its pill. On a ruled line it belongs at the left edge, and the
     input pads to clear it. */
  #help-search .pagefind-ui__form::before {
    left: 1px;
    top: 50%;
    width: 13px;
    height: 13px;
    transform: translateY(-50%);
    opacity: 0.8;
  }

  #help-search .pagefind-ui__search-input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  #help-search .pagefind-ui__search-input:focus {
    outline: none;
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }

  /* Pagefind draws its own magnifier as a background image on the form and its
     clear button as absolutely-positioned text; both are sized off the pill. */
  #help-search .pagefind-ui__search-clear {
    background: transparent;
    color: var(--text-muted);
    font-size: 12px;
    padding: 0 2px;
  }

  #help-search .pagefind-ui__search-clear:hover {
    color: var(--text);
  }

  /* Results float over the page, so this one keeps a surface and a border. */
  #help-search .pagefind-ui__results {
    position: absolute;
    z-index: 50;
    width: 220px;
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(38, 34, 25, 0.28);
    max-height: 60vh;
    overflow-y: auto;
  }

  #help-search .pagefind-ui__result {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--hair);
  }

  #help-search .pagefind-ui__result:last-child {
    border-bottom: none;
  }

  #help-search .pagefind-ui__result-title {
    font-size: 0.8125rem;
    color: var(--text);
  }

  #help-search .pagefind-ui__result-link {
    color: var(--accent-ink);
  }

  #help-search .pagefind-ui__result-excerpt {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* The matched term, marked like a highlighter pass. --accent-wash is tuned to
     sit *under* content as a tint and measures ~1.15:1 against the results
     panel, which makes the match all but invisible; a highlight has to actually
     read as one. Weight carries it as well as color, so the match is still
     obvious if the wash is lost (forced colors, printing). */
  #help-search mark {
    /* --accent-ink, not raw petrol: petrol is a mid-dark teal, so washing it
       over the slate panel moves the luminance by almost nothing (measured
       1.09:1) and the highlight vanishes in dark mode. --accent-ink is the
       per-theme legible variant, so it darkens on paper and lightens on slate
       and the swipe reads in both. */
    background: color-mix(in srgb, var(--accent-ink) 30%, transparent);
    color: var(--text);
    font-weight: 600;
    border-radius: 2px;
    padding: 0 1px;
  }

  #help-search .pagefind-ui__message {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
</style>

<style>
  /* Desktop: a plain sticky column. We do NOT cap the height with an internal
     scroll, because that scroll relied on a flex chain running through the
     <details> element, which does not establish a reliable flex height context,
     so the nav would spill past the footer. With no cap, the sidebar's full
     height stays in the flex flow and the footer always lands below it. */
  #help-sidebar {
    width: 220px;
    flex-shrink: 0;
    position: sticky;
    top: 1.5rem;
  }

  /* ---- the index ---- */

  .sgroup {
    margin-bottom: 22px;
  }

  /* Caps label over a hairline: the group heading of a journal index. */
  .sgroup-label {
    display: block;
    font-size: 10px;
    color: var(--text-muted);
    margin: 0 0 2px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--hair);
  }

  .sgroup ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Quiet rows. The keyline slot is reserved on every row, so marking one active
     moves no text. */
  .sgroup-link {
    display: block;
    padding: 6px 0 6px 10px;
    font-size: 13.5px;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  .sgroup-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .sgroup-link.active {
    color: var(--accent-ink);
    font-weight: 600;
    border-left-color: var(--accent);
  }

  .help-search-wrap {
    margin-bottom: 22px;
    /* Pagefind ships this div empty and injects the search input at runtime, so
       without a reservation everything below it drops by the input's height the
       moment the bundle lands. That shift was always here; it only became
       measurable once the page started painting before the injection. Reserving
       the height keeps CLS at 0.
       Re-measured for M-web-2: the field is now a ruled line sized by its own
       padding (7px + 20.8px line-box + 7px + 1.5px rule = 36.3px) rather than
       the 51.19px pill pagefind pins off --pagefind-ui-scale. The line-height is
       a fixed px value, so this holds whether or not the webfont has landed.
       Re-measure if the field's padding, font-size, or that scale changes. */
    min-height: 36.3px;
  }

  #help-nav-details > summary {
    list-style: none;
    cursor: pointer;
  }
  #help-nav-details > summary::-webkit-details-marker {
    display: none;
  }

  /* Desktop: hide the summary, keep the nav always visible.
     The inline script removes `open` on mobile - on desktop it stays open. */
  @media (min-width: 769px) {
    #help-nav-details > summary {
      display: none;
    }
  }

  /* Mobile: sidebar becomes a static, full-width block above content.
     Summary turns into a tappable "Browse help topics" bar. */
  @media (max-width: 768px) {
    #help-sidebar {
      width: 100%;
      position: static;
      max-height: none;
      margin-bottom: 1.5rem;
    }

    /* A disclosure control, so it keeps an edge: this is the one box in the
       sidebar and it earns it by being tappable chrome rather than content. */
    .help-nav-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: var(--surface);
      border: 1px solid var(--outline);
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text);
    }

    .help-nav-toggle-icon {
      transition: transform 0.15s ease;
    }

    #help-nav-details[open] .help-nav-toggle-icon {
      transform: rotate(180deg);
    }

    #help-sidebar-nav {
      margin-top: 0.5rem;
      padding: 0.75rem 1rem 0.25rem;
      max-height: 70vh;
      overflow-y: auto;
      border: 1px solid var(--outline);
      border-radius: 8px;
      background: var(--surface);
    }
  }
</style>

<script is:inline>
  (function () {
    // Default the mobile disclosure to closed; leave it open on desktop.
    const details = document.getElementById('help-nav-details');
    if (details && window.matchMedia('(max-width: 768px)').matches) {
      details.removeAttribute('open');
    }

    // Preserve nav scroll position across clicks.
    const KEY = 'help-sidebar-scroll';
    const nav = document.getElementById('help-sidebar-nav');
    if (!nav) return;

    const saved = sessionStorage.getItem(KEY);
    if (saved) nav.scrollTop = parseInt(saved, 10);

    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        sessionStorage.setItem(KEY, nav.scrollTop);
      });
    });
  })();
</script>
