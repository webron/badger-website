---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HelpSidebar from '../components/HelpSidebar.astro';
import { addHeadingAnchors } from '../lib/heading-anchors.mjs';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Every h2/h3 gets an id and a link icon at build time (see the module for why
// not in the browser).
const article = addHeadingAnchors(await Astro.slots.render('default'));
---

<BaseLayout title={title} description={description}>
  <!-- Forwarded so a guide page can pass its own JSON-LD (see ArticleSchema)
       into <head>. Without this the named slot is swallowed here and the
       markup lands in the article body, where a crawler ignores it. -->
  <slot name="head" slot="head" />

  <Header currentPath={currentPath} />

  <div class="help-shell">
    <HelpSidebar currentPath={currentPath} />

    <main class="help-main">
      <article class="prose">
        <Fragment set:html={article} />
      </article>
      <p class="heading-anchor-status sr-only" aria-live="polite"></p>
    </main>
  </div>

  <Footer />
</BaseLayout>

<script>
  // The heading link still does its normal job (jump to the section, put the
  // #fragment in the address bar). It also copies the full URL, which is what
  // a reader clicking it almost always wants.
  const status = document.querySelector('.heading-anchor-status');

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Older Safari and some embedded browsers refuse the async clipboard.
      // The old selection-based copy still works there inside a click.
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      field.remove();
      return ok;
    }
  }
  let reset: number | undefined;
  document.addEventListener('click', async (event) => {
    const link = (event.target as Element | null)?.closest?.('a.heading-anchor') as HTMLAnchorElement | null;
    if (!link) return;
    if (!(await copyText(link.href))) return; // The address bar still has it.
    document.querySelectorAll('a.heading-anchor.is-copied').forEach((a) => a.classList.remove('is-copied'));
    link.classList.add('is-copied');
    if (status) status.textContent = 'Link copied';
    window.clearTimeout(reset);
    reset = window.setTimeout(() => {
      link.classList.remove('is-copied');
      if (status) status.textContent = '';
    }, 1600);
  });
</script>

<style>
  .help-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    min-height: calc(100vh - 10rem);
  }

  .help-main {
    flex: 1;
    min-width: 0;
  }

  .help-main .prose {
    max-width: 720px;
  }

  @media (max-width: 768px) {
    .help-shell {
      padding: 1rem 1rem;
      gap: 0;
      flex-direction: column;
      /* Stretch, not flex-start: once the column direction flips, align-items
         governs WIDTH, and flex-start sizes each item to fit-content. That can
         never go below its content's minimum width, so a single wide child (the
         JSON example on /badger-format) widened the whole column past the phone
         and the page scrolled sideways. Stretching pins the column to the
         viewport, and wide children scroll inside their own boxes as intended.
         No visual change for pages whose content already fits. */
      align-items: stretch;
    }

    .help-main .prose {
      max-width: 100%;
    }
  }
</style>
