---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  fullTitle?: string;
}

const {
  title,
  description = 'Badger is a workout tracker. Log sets, run your programs, and track what your training is actually doing.',
  canonical,
  fullTitle: fullTitleProp,
} = Astro.props;

const fullTitle = fullTitleProp ?? (title === 'Badger' ? 'Badger' : `${title} - Badger`);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/assets/og_image.png', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Badger" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts are self-hosted and subset (tool/subset-fonts.sh): no font CDN, no
         external requests. The site must be as private as the app it advertises.
         Only the two faces used above the fold are preloaded; the Literata italic
         swaps in later behind a metric-matched fallback. -->
    <link rel="preload" href="/fonts/exo2-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F1EDE3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1C1A16" />
    <!-- Direction E journal favicon: ink badger head on a paper rounded square,
         stripe bands dropped (they turn to noise at 16-32px). Modern browsers
         take the SVG; the 16/32/48 .ico is the legacy fallback. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <script is:inline>
      // Apply the saved theme before first paint. This has to live in <head> and
      // run synchronously: from the end of <body> it can repaint over a rendered
      // frame, which is the flash it is meant to prevent.
      (function () {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>

    <!-- GoatCounter: the site's only external request, and the only one the
         fonts note above does not already rule out. Cookieless and storage-free:
         it sends one hit per pageview (path, referrer, and a country resolved
         from the IP server-side, which is then discarded), keeps no identifier,
         and builds no cross-visit profile. Disclosed in /legal/privacy under
         "About this website". Skipped in dev builds; count.js additionally
         ignores localhost and private ranges on its own. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://badgerfit.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
