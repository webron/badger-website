---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  fullTitle?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Badger is a workout tracker. Log sets, run your programs, and track what your training is actually doing.',
  canonical,
  fullTitle: fullTitleProp,
  noindex = false,
} = Astro.props;

const fullTitle = fullTitleProp ?? (title === 'Badger' ? 'Badger' : `${title} - Badger`);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/assets/og_image.png', Astro.site).toString();

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* GitHub Pages cannot send headers, so the CSP is a meta tag; it only governs what
         follows it, so it stays first. script-src names the one analytics host (it
         cannot be pinned with SRI) so another script host cannot run if it is
         swapped for a lookalike or injected. 'unsafe-inline' stays because pages carry
         inline scripts (theme, JSON-LD, the 5-3-1 calculator) whose hashes change with
         every edit. 'wasm-unsafe-eval' is for Pagefind search, which compiles WebAssembly.
         Not covered by a meta tag: frame-ancestors, and the report/sandbox directives. */}
    <meta
      http-equiv="content-security-policy"
      content="script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://gc.zgo.at; base-uri 'self'; form-action 'none'; object-src 'none'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Badger" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts are self-hosted and subset (tool/subset-fonts.sh): no font CDN, no
         external requests. The site must be as private as the app it advertises.
         Only the two faces used above the fold are preloaded; the Literata italic
         swaps in later behind a metric-matched fallback. -->
    <link rel="preload" href="/fonts/exo2-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Browser chrome (address bar tint, scrollbars, native controls) follows the
         OS preference by default. When a theme is chosen or saved, the script
         below rewrites these so they follow the site's theme instead. -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F1EDE3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1C1A16" />
    <!-- Direction E journal favicon: ink badger head on a paper rounded square,
         stripe bands dropped (they turn to noise at 16-32px). Modern browsers
         take the SVG; the 16/32/48 .ico is the legacy fallback. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <script is:inline>
      // Apply the saved theme before first paint. This has to live in <head> and
      // run synchronously: from the end of <body> it can repaint over a rendered
      // frame, which is the flash it is meant to prevent. The metas it updates
      // are declared above, so they already exist when it runs.
      (function () {
        var COLORS = { light: '#F1EDE3', dark: '#1C1A16' };
        var root = document.documentElement;

        // Single place that switches theme: the attribute the stylesheet keys
        // on, plus the metas the browser reads for its own UI.
        window.__setTheme = function (theme) {
          root.setAttribute('data-theme', theme);
          var metas = document.head.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', COLORS[theme]);
          var scheme = document.head.querySelector('meta[name="color-scheme"]');
          if (scheme) scheme.setAttribute('content', theme);
        };

        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        if (saved === 'light' || saved === 'dark') window.__setTheme(saved);

        // Cross-document transitions animate the header and stripe in place, but
        // those are not sticky: on a scrolled page they sit off-screen and would
        // slide in from above. Drop their names for that navigation.
        window.addEventListener('pageswap', function () {
          if (window.scrollY > 0) root.classList.add('vt-scrolled');
        });
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) root.classList.remove('vt-scrolled');
        });
      })();
    </script>

    <!-- GoatCounter: page-view counting. The site's one other external request is
         the AppTierList footer image; the fonts note above rules out font requests. Cookieless and storage-free:
         it sends one hit per pageview (path, referrer, and a country resolved
         from the IP server-side, which is then discarded), keeps no identifier,
         and builds no cross-visit profile. Disclosed in /legal/privacy under
         "About this website". Skipped in dev builds; count.js additionally
         ignores localhost and private ranges on its own. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://badgerfit.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
