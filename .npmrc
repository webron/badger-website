# Supply-chain hardening (2026-10-20). See .github/dependabot.yml for the other half.
# Dependency install scripts never run: the 2025-26 npm worms (Shai-Hulud,
# TanStack, ChainDrop) ran from preinstall/postinstall.
ignore-scripts=true
# Only resolve versions published at least 3 days ago. Most malicious releases
# were pulled within 1-3 days. Needs npm >= 11.10; older npm ignores it.
# Locked versions are not affected: npm ci and npm install keep the lockfile.
min-release-age=3
